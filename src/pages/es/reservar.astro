---
export const prerender = true;

import Base from "@layouts/Base.astro";
import BookingPageLayout from "@components/booking/BookingPageLayout.astro";

const metadata = {
  title: "Diagnóstico de Inglés Profesional",
  description:
    "Agenda un diagnóstico de 30 minutos. Revisaremos tu próximo reto profesional en inglés y si el coaching privado es adecuado para ti.",
};

const heroContent = {
  title: "Reserva Tu Diagnóstico de 30 Minutos",
  description:
    "Una conversación directa sobre tu próximo reto profesional en inglés, el resultado que necesitas y si este enfoque es adecuado para ti.",
};
---

<Base
  lang="es"
  tkey="book"
  title={metadata.title}
  description={metadata.description}
  ogImage={{ src: "/images/logos/new-york-english-sq-og.jpg" }}
>
  <BookingPageLayout lang="es" title={heroContent.title} description={heroContent.description}>
    <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
      ¿Necesitas cancelar o reprogramar? Por favor avisa con al menos 24 horas de anticipación.
      Consulta nuestra <a
        href="/es/legal/cancellation-policy/"
        class="underline hover:text-gray-700 dark:hover:text-gray-200">Política de Cancelación</a
      >.
    </p>
  </BookingPageLayout>
</Base>
