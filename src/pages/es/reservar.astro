---
export const prerender = true;

import Base from "@layouts/Base.astro";
import InnerHero from "@components/sections/InnerHero.astro";
import BookingFormSteps from "@components/booking/BookingFormSteps.astro";
import bookingHero from "@assets/images/contact/book-hero.jpg";

const metadata = {
  title: "Diagnóstico de Inglés Profesional | NY English Teacher",
  description:
    "Agenda un diagnóstico de 15 minutos. Revisaremos tu próximo reto profesional en inglés y si el coaching privado es adecuado para ti.",
};

const heroContent = {
  title: "Reserva Tu Diagnóstico de 15 Minutos",
  description:
    "Una conversación directa sobre tu próximo reto profesional en inglés, el resultado que necesitas y si este enfoque es adecuado para ti.",
  backgroundImage: bookingHero,
  overlayOpacity: 0.6,
};
---

<Base
  lang="es"
  tkey="book"
  title={metadata.title}
  description={metadata.description}
  ogImage={{ src: "/images/logos/new-york-english-sq-og.jpg" }}
>
  <main>
    <InnerHero content={heroContent} />

    <section class="py-16 md:py-24 bg-background-light">
      <div class="site-container px-4">
        <!-- Booking Form with Steps -->
        <BookingFormSteps lang="es" />

        <p class="mt-8 text-center text-sm text-gray-500">
          ¿Necesitas cancelar o reprogramar? Por favor avisa con al menos 24 horas de anticipación.
          Consulta nuestra <a
            href="/es/legal/cancellation-policy/"
            class="underline hover:text-gray-700">Política de Cancelación</a
          >.
        </p>
      </div>
    </section>
  </main>
</Base>
