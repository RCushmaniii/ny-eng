---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Hero from "@components/sections/Hero.astro";
import SplitPanel from "@components/sections/SplitPanel.astro";
import Features from "@components/sections/Features.astro";
import Testimonials from "@components/sections/Testimonials-titan.astro";
import HomepageFAQ from "@components/HomepageFAQ";
import FAQSchema from "@components/seo/FAQSchema.astro";
import { homepageFAQs } from "@data/homepage-faqs";

// Define language and tkey for i18n
const lang = "es";
const tkey = "home";

import { testimonials } from "@data/testimonials-es";

import heroSkyline from "@assets/images/home/new-york-city-skyline.webp";
import styleGuideImage from "@assets/images/home/developer.jpg";
import { GraduationCap, Briefcase, Presentation, Users } from "lucide-astro";

const testimonialsBlock = {
  eyebrow: "Resultados Reales",
  title: "Coaching de Inglés para Profesionales | Robert Cushman",
  description: "Comentarios reales de clientes reales.",
  testimonials,
  cta: {
    heading: "Para profesionales que lideran en todos los idiomas menos uno.",
    description:
      "En 15 minutos identificaremos la situación profesional que más te importa y si este enfoque es adecuado para ti.",
    text: "Reservar Diagnóstico de 15 Minutos",
    link: "/es/reservar/",
    rel: "noopener noreferrer",
  },
};

const seoTitle = "Coaching de Inglés en Guadalajara, desde Tus Juntas";
const seoDescription =
  "Diriges con autoridad en español. Coaching privado de inglés construido desde tus juntas reales y tu próximo momento de presión, no desde un libro.";

const heroContent = {
  eyebrow: "Coaching Privado de Inglés para Líderes en México",
  title: "Eres líder en español. Que tu inglés refleje la misma experiencia.",
  description:
    "Prepara tus juntas, presentaciones, entrevistas y negociaciones reales con un coach estadounidense. Cada sesión se construye alrededor de tu próximo momento profesional importante — no de un libro de texto.",
  microcopy: "Coaching privado: 500 MXN por sesión de 60 minutos · Diagnóstico inicial sin costo",
  trustLine:
    "Resultados con líderes de Driscoll’s México, Continental, Sanmina Corporation y CEVA Logistics",
  trustLineLink: "/es/testimonios/",
  buttons: [
    {
      text: "Reservar Diagnóstico de 15 Minutos",
      link: "/es/reservar/",
      variant: "primary" as const,
    },
    // Single CTA for higher conversion - matches EN page
  ],
  backgroundImage: heroSkyline,
  backgroundImageMobile: heroSkyline,
  overlayOpacity: 0.9,
  fullHeight: true,
} as const;

const featuresSection = {
  eyebrow: "NY ENGLISH OFRECE",
  title: "¿Dónde te cuesta más tu inglés?",
  description:
    "Selecciona el camino enfocado que se alinea con tus objetivos profesionales específicos.",
  features: [
    {
      tag: "Líderes Ejecutivos",
      title: "Tu estrategia es sólida. Tu inglés no está a la altura.",
      description:
        "Domina la sala de juntas, lidera negociaciones y habla con la claridad que el liderazgo global exige — sin traducir en tu cabeza.",
      icon: Briefcase,
      link: "/es/quiz/executives/",
    },
    {
      tag: "Líderes en Tecnología",
      title: "Tu código es impecable. Tu explicación pierde a la audiencia.",
      description:
        "Convierte la complejidad técnica en valor de negocio claro que ejecutivos, clientes y grupos de interés entienden de inmediato.",
      icon: Presentation,
      link: "/es/quiz/it-services/",
    },
    {
      tag: "Servicios Profesionales",
      title: "Una palabra mal elegida puede costar más que tus honorarios.",
      description:
        "Inglés de precisión para profesionales médicos y legales que deben comunicarse con claridad absoluta cuando lo que está en juego es real.",
      icon: Users,
      link: "/es/quiz/professional-services/",
    },
    {
      tag: "Entrevistas y Presentaciones",
      title: "Tienes una oportunidad. Suena preparado.",
      description:
        "Preparación enfocada para entrevistas, pitches a inversionistas y las presentaciones que cambian carreras.",
      icon: GraduationCap,
      link: "/es/quiz/high-stakes/",
    },
  ],
} as const;

const styleGuideSection = {
  eyebrow: "Mi Metodología",
  headline: "Cada clase se construye a partir de tu próxima reunión, no de un libro de texto.",
  description:
    "Diseño cada sesión en torno a tu rol real, tu industria y tus plazos. Si tienes una presentación ante la junta el jueves, para eso te preparo el miércoles. Nada genérico. Nada teórico.",
  descriptionPoints: [
    "Tu plan de estudios, no un catálogo de cursos — sesiones construidas a partir de tus escenarios reales, el vocabulario de tu industria, tus próximos momentos de presión.",
    'Tu voz, afinada — retroalimentación táctica sobre tono, pronunciación y las señales sutiles que separan "fluido" de "contundente."',
    "Tu espacio de ensayo — simula el pitch, la negociación o la llamada con el cliente antes de que cuente. Comete errores aquí, no allá.",
  ],
  image: {
    src: styleGuideImage,
    alt: "Sesión de coaching ejecutivo en progreso",
  },
  buttons: [
    {
      text: "Reservar Diagnóstico de 15 Minutos",
      link: "/es/reservar/",
      variant: "primary" as const,
    },
  ],
};
---

<Base
  lang={lang}
  tkey={tkey}
  title={seoTitle}
  description={seoDescription}
  heroImage={heroContent.backgroundImage}
  heroImageMobile={heroContent.backgroundImageMobile}
  ogImage={{ src: "/images/logos/new-york-english-sq-og.jpg" }}
  transparentHeader={true}
>
  <div class="relative bg-background-light">
    <Hero content={heroContent} />

    {/* ARCS — CALL OUT: "¿Te identificas?" — espejo de identidad */}
    <section class="bg-gray-950 py-16 sm:py-20 border-t border-gray-800">
      <div class="site-container mx-auto px-4 max-w-3xl text-center">
        <p
          class="text-sm font-bold uppercase tracking-wider mb-6"
          style="color: #FFC107; letter-spacing: 0.1em;"
        >
          ¿Te identificas?
        </p>
        <p class="text-xl sm:text-2xl leading-relaxed text-white font-normal">
          Si diriges juntas, cierras acuerdos y gestionas equipos en tu idioma nativo — pero te
          sientes menos preciso, menos contundente, <em
            class="font-semibold not-italic"
            style="color: #FFC107;">menos tú mismo</em
          > cuando cambias al inglés — esto fue creado para ti.
        </p>
      </div>
    </section>

    {
      /* El mecanismo aparece antes de los recursos gratuitos: esta página vende
        coaching privado antes de ofrecer rutas de autoestudio. */
    }
    <SplitPanel
      content={styleGuideSection}
      imagePosition="right"
      background="light"
      padding="base"
      lang="es"
    />

    <div class="mb-15 pb-0">
      <Testimonials content={testimonialsBlock} background="base" padding="small" />
    </div>

    <section class="bg-gray-950 py-16 sm:py-20 text-white">
      <div class="site-container mx-auto px-4 max-w-5xl">
        <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider mb-4 text-amber-400">
              Un plan construido alrededor de tu trabajo
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold mb-5">
              No compras una hora de conversación. Preparas el momento que sigue.
            </h2>
            <p class="text-lg leading-relaxed text-gray-300">
              Trabajamos con tus presentaciones, juntas, entrevistas, negociaciones y mensajes
              reales. Practicas antes de que cuente y recibes retroalimentación enfocada en
              claridad, pronunciación, tono y presencia profesional.
            </p>
          </div>
          <div class="rounded-2xl border border-gray-700 bg-gray-900 p-7 sm:p-8 shadow-xl">
            <p class="text-sm font-semibold uppercase tracking-wider text-amber-400 mb-2">
              Inversión clara
            </p>
            <p class="text-4xl font-bold mb-2">500 MXN</p>
            <p class="text-gray-300 mb-6">por sesión privada de 60 minutos</p>
            <p class="text-xl font-semibold mb-2">Plan ejecutivo: 6,000 MXN</p>
            <p class="text-gray-400 mb-7">
              12 sesiones enfocadas en tu rol, industria y próximos retos profesionales.
            </p>
            <a
              href="/es/reservar/"
              class="inline-flex w-full items-center justify-center rounded-lg bg-amber-500 px-5 py-3 font-bold text-gray-950 transition hover:bg-amber-400"
            >
              Reservar Diagnóstico de 15 Minutos
            </a>
            <p class="mt-4 text-center text-sm text-gray-400">Sin costo y sin compromiso.</p>
          </div>
        </div>
      </div>
    </section>

    <Features content={featuresSection} padding="small" background="light" />

    <!-- Homepage FAQ Section -->
    <FAQSchema faqs={homepageFAQs.es.faqs} />
    <HomepageFAQ client:load lang="es" />

    <section class="border-t border-gray-200 bg-white py-12">
      <div class="site-container mx-auto px-4 text-center">
        <p class="text-gray-600 mb-4">¿Todavía no estás listo para una conversación privada?</p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 font-semibold">
          <a class="text-primary hover:underline" href="/es/assessments/"
            >Realizar la evaluación de 90 segundos</a
          >
          <a class="text-primary hover:underline" href="/es/cursos/"
            >Explorar los cursos gratuitos</a
          >
          <a class="text-primary hover:underline" href="/es/blog/">Leer recursos prácticos</a>
        </div>
      </div>
    </section>
  </div>
</Base>
