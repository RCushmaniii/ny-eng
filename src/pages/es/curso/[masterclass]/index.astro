---
export const prerender = true;

import Base from "@layouts/Base.astro";
import { courseOg } from "@/lib/courseOg";
import MasterclassHub from "@components/course/masterclass/MasterclassHub.astro";
import MasterclassSchema from "@components/course/masterclass/MasterclassSchema.astro";
import { courseTKey, courses, pick, type Course } from "@data/masterclass/index";

export function getStaticPaths() {
  return courses.map((course) => ({ params: { masterclass: course.slugEs }, props: { course } }));
}

interface Props {
  course: Course;
}
const { course } = Astro.props;
const lang = "es";
const tkey = courseTKey(course);
---

<Base
  lang={lang}
  tkey={tkey}
  ogImage={courseOg(course.id, lang, pick(course.name, lang))}
  title={pick(course.metaTitle, lang)}
  description={pick(course.description, lang)}
>
  <MasterclassHub lang={lang} course={course} />
  <MasterclassSchema lang={lang} course={course} />
</Base>
