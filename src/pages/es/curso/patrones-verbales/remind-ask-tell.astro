---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import PatternDrill from "@components/course/PatternDrill";
import ErrorCorrection from "@components/course/ErrorCorrection";
import { l2Drill, l2Corrections } from "@data/verb-patterns/lesson-2";
import CourseLessonSchema from "@components/seo/CourseLessonSchema.astro";
import { ArrowRight, MessageSquare, CheckCircle2 } from "lucide-astro";

const lang = "es";
const tkey = "course/verb-patterns/remind-ask-tell" as const;

const askPatterns = [
  ["ask someone something", "I asked my boss a question.", "una pregunta directa"],
  ["ask someone for something", "I asked my boss for help.", "quieres recibirlo"],
  ["ask someone about something", "I asked my boss about the project.", "quieres información"],
  ["ask someone to do something", "I asked my boss to review it.", "quieres una acción"],
];
const tellPatterns = [
  ["tell someone something", "I told my team the decision.", "información directa"],
  ["tell someone about something", "I told my team about the decision.", "comentar un tema"],
  ["tell someone to do something", "I told my team to arrive early.", "una instrucción"],
];
---

<Base
  lang={lang}
  tkey={tkey}
  title="Remind, Ask & Tell: about vs for vs to do | Patrones Verbales Lección 2"
  description="Lección 2 de Patrones Verbales: remind, ask y tell. Elige about vs for vs to-do — el conector que corresponde a tu significado. Gratis."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <MessageSquare class="w-4 h-4" />
          Nivel 1 · Fundamentos — Lección 2
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Remind, Ask &amp; Tell
        </h1>
        <p class="text-2xl text-indigo-300 italic font-light mb-4">¿about un tema, o to do una acción?</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Estos tres verbos llevan la persona directamente — sin “to”. Pero la palabra que agregas después
          (<em class="text-white not-italic">about</em>, <em class="text-white not-italic">for</em>,
          <em class="text-white not-italic">to&nbsp;do</em>) cambia el significado. Aquí el significado <em>sí</em> te guía —
          una vez que sabes qué conectores acepta cada verbo.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección 1 -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Un verbo, varios significados</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">El conector hace el trabajo.</p>
        <div class="space-y-4 text-lg text-slate-700 leading-relaxed">
          <p>
            Los tres verbos ponen la persona primero, directa: <em>remind my team</em>, <em>ask my boss</em>,
            <em>tell the client</em>. Nunca <em>remind to</em>, <em>ask to</em>, ni <em>tell to</em> la persona.
            Lo que viene <strong>después</strong> de la persona es donde vive el significado:
          </p>
          <div class="grid sm:grid-cols-2 gap-4 my-4">
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">about + tema</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">I reminded my team about the deadline.</p>
                <AudioButton client:visible text="I reminded my team about the deadline." lang="en-US" size="sm" />
              </div>
            </div>
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">to + acción</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">I reminded my team to send the report.</p>
                <AudioButton client:visible text="I reminded my team to send the report." lang="en-US" size="sm" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 2: Ask -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Ask — cuatro patrones</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Mismo verbo. El conector decide qué quieres decir.</p>
        <div class="space-y-3">
          {askPatterns.map(([p, s, note]) => (
            <div class="bg-white rounded-xl border border-slate-200 p-4">
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-mono text-indigo-700">{p}</p>
                <span class="text-xs text-slate-400">{note}</span>
              </div>
              <div class="flex items-center gap-2 mt-1">
                <p class="text-slate-800 flex-1">{s}</p>
                <AudioButton client:visible text={s} lang="en-US" size="sm" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 3: Tell -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Tell — tres patrones</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Información directa, un tema o una instrucción.</p>
        <div class="space-y-3">
          {tellPatterns.map(([p, s, note]) => (
            <div class="bg-white rounded-xl border border-slate-200 p-4">
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-mono text-indigo-700">{p}</p>
                <span class="text-xs text-slate-400">{note}</span>
              </div>
              <div class="flex items-center gap-2 mt-1">
                <p class="text-slate-800 flex-1">{s}</p>
                <AudioButton client:visible text={s} lang="en-US" size="sm" />
              </div>
            </div>
          ))}
        </div>
        <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
          <strong>Ojo:</strong> usa <em>tell</em> con una persona (tell me) y <em>say</em> sin persona (say that). <span class="line-through">say me the truth</span> → tell me the truth.
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 4: PatternDrill -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Ejercicio: elige el conector</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">¿Tema, acción, recibir o directo? Elige y verifica.</p>
        <PatternDrill client:visible data={l2Drill} lang="es" />
      </div>
    </div>
  </section>

  <!-- Sección 5: ErrorCorrection -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">5</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Encuentra el error</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Toca la parte incorrecta de cada oración.</p>
        <ErrorCorrection client:visible data={l2Corrections} lang="es" />
      </div>
    </div>
  </section>

  <!-- Recap + siguiente -->
  <section class="py-16 md:py-20 bg-slate-50 border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6 text-center">El resumen</h2>
        <div class="bg-white rounded-2xl border border-slate-200 p-8 mb-10">
          <ul class="space-y-3 text-slate-700">
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>La persona siempre va directa</strong> — nunca remind/ask/tell <em>to</em> una persona.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>about</strong> = un tema · <strong>to&nbsp;do</strong> = una acción · <strong>for</strong> = quieres recibirlo.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>tell</strong> con persona; <strong>say</strong> sin persona.</span></li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-slate-600 mb-6">A continuación: <strong class="text-slate-900">Give, Send y la trampa de Explain</strong> — dos órdenes correctos, y el verbo que rompe la regla.</p>
          <Button href="/es/curso/patrones-verbales/give-send-explain/" variant="primary" size="lg">
            Lección 3: Give, Send &amp; Explain
            <ArrowRight class="w-5 h-5 ml-1" />
          </Button>
          <div class="mt-6">
            <a href="/es/curso/patrones-verbales/" class="text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2">← Volver al resumen del curso</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <CourseLessonSchema {lang} {tkey} />
</Base>
