---
export const prerender = true;

import Base from "@layouts/Base.astro";
import { courseOg } from "@/lib/courseOg";
import CourseLessonSchema from "@components/seo/CourseLessonSchema.astro";
import CollocationsReference from "@components/course/collocations/CollocationsReference.astro";
import { getGroups } from "@data/collocations/index";

const lang = "es";
const tkey = "course/verb-patterns/collocations" as const;
const total = getGroups(lang).reduce((n, g) => n + g.items.length, 0);
---

<Base
  lang={lang}
  tkey={tkey}
  ogImage={courseOg("collocations", lang, "Las Palabras Correctas para el Trabajo")}
  title="Colocaciones en Inglés de Negocios: Verbo + Preposición"
  description={`${total} colocaciones del inglés de negocios agrupadas por significado: verbo + preposición, adjetivo + preposición y los verbos que no llevan preposición.`}
>
  <CollocationsReference lang={lang} />
  <CourseLessonSchema {lang} {tkey} />
</Base>
