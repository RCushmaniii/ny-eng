---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import PatternDrill from "@components/course/PatternDrill";
import ErrorCorrection from "@components/course/ErrorCorrection";
import { l4Drill, l4Corrections } from "@data/verb-patterns/lesson-4";
import { ArrowRight, Link as LinkIcon, CheckCircle2, XCircle } from "lucide-astro";

const lang = "es";
const tkey = "course/verb-patterns/verb-preposition" as const;

const families = [
  ["ON", "depend on · rely on · focus on · work on · insist on", "I depend on my team."],
  ["FOR", "wait for · look for · apply for · pay for · prepare for", "We prepared for the meeting."],
  ["ABOUT", "think about · worry about · complain about · hear about", "She worried about the deadline."],
  ["WITH", "agree with · deal with · meet with · work with", "He dealt with the problem."],
  ["IN", "believe in · participate in · succeed in · invest in", "They invested in new technology."],
  ["FROM", "hear from · borrow from · learn from · recover from", "We learned from our mistakes."],
];

const traps = [
  ["depend of", "I depend on my team."],
  ["focus in", "We focus on the problem."],
  ["apply to a job", "He applied for a new job."],
];
---

<Base
  lang={lang}
  tkey={tkey}
  title="Verbo + Preposición: depend on, wait for, worry about | Patrones Verbales Lección 4"
  description="Lección 4 de Patrones Verbales. Las seis familias de preposiciones — depend on, wait for, worry about. Deja de decir 'depend of' y 'focus in'."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <LinkIcon class="w-4 h-4" />
          Nivel 2 · Patrones — Lección 4
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Verbo + Preposición
        </h1>
        <p class="text-2xl text-indigo-300 italic font-light mb-4">Algunos verbos están pegados a una preposición.</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Muchos verbos en inglés llevan una preposición fija — aprendes <em class="text-white not-italic">depend on</em>,
          <em class="text-white not-italic">wait for</em>, <em class="text-white not-italic">worry about</em> como un solo
          bloque, no como dos palabras separadas. El español traslada sus propias preposiciones, y por eso
          <span class="line-through">depend of</span> y <span class="line-through">focus in</span> se sienten correctos pero
          están mal. Memoriza el par, no el verbo solo.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección 1: las seis familias -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Las seis familias</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Agrupa los verbos por la preposición que llevan y el patrón se fija.</p>
        <div class="grid sm:grid-cols-2 gap-4">
          {families.map(([prep, verbs, example]) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
              <span class="inline-block px-2.5 py-0.5 rounded-md bg-indigo-600 text-white text-xs font-bold tracking-wider mb-3">{prep}</span>
              <p class="text-sm text-slate-600 mb-3 leading-relaxed">{verbs}</p>
              <div class="flex items-center gap-2 border-t border-slate-200 pt-3">
                <p class="text-slate-900 flex-1 font-medium">{example}</p>
                <AudioButton client:visible text={example} lang="en-US" size="sm" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 2: de dónde vienen los errores -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">De dónde vienen los errores</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Casi todos los errores son el español prestándote la preposición equivocada.</p>
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 space-y-4">
          {traps.map(([wrong, right]) => (
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
              <div class="flex items-center gap-2 sm:w-1/3">
                <XCircle class="w-5 h-5 text-red-500 shrink-0" />
                <span class="text-red-700 line-through">{wrong}</span>
              </div>
              <ArrowRight class="w-5 h-5 text-amber-500 shrink-0 hidden sm:block" />
              <div class="flex items-center gap-2 flex-1">
                <CheckCircle2 class="w-5 h-5 text-green-600 shrink-0" />
                <span class="text-slate-900 font-medium flex-1">{right}</span>
                <AudioButton client:visible text={right} lang="en-US" size="sm" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 3: PatternDrill -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Ejercicio: ¿cuál preposición?</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Cada verbo está pegado a una preposición. Elígela y verifica.</p>
        <PatternDrill client:visible data={l4Drill} lang="es" />
      </div>
    </div>
  </section>

  <!-- Sección 4: ErrorCorrection -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Encuentra el error</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Toca la preposición incorrecta en cada oración.</p>
        <ErrorCorrection client:visible data={l4Corrections} lang="es" />
      </div>
    </div>
  </section>

  <!-- Resumen + siguiente -->
  <section class="py-16 md:py-20 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6 text-center">El resumen</h2>
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-8 mb-10">
          <ul class="space-y-3 text-slate-700">
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>Aprende el verbo y su preposición como un solo bloque</strong> — <em>depend on</em>, no <em>depend</em> + una adivinanza.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>Seis familias:</strong> ON · FOR · ABOUT · WITH · IN · FROM. Agrupa los verbos nuevos en ellas.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>La mayoría de los errores son el español filtrándose</strong> — <span class="line-through">depend of</span>, <span class="line-through">focus in</span>.</span></li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-slate-600 mb-6">A continuación: <strong class="text-slate-900">To Do vs Doing</strong> — cuándo un verbo lleva el infinitivo, y cuándo necesita la forma -ing.</p>
          <Button href="/es/curso/patrones-verbales/to-do-vs-doing/" variant="primary" size="lg">
            Lección 5: To Do vs Doing
            <ArrowRight class="w-5 h-5 ml-1" />
          </Button>
          <div class="mt-6">
            <a href="/es/curso/patrones-verbales/" class="text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2">← Volver al resumen del curso</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
