---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import PatternDrill from "@components/course/PatternDrill";
import ErrorCorrection from "@components/course/ErrorCorrection";
import { l8Drill, l8Corrections } from "@data/verb-patterns/lesson-8";
import CourseLessonSchema from "@components/seo/CourseLessonSchema.astro";
import { ArrowRight, Shuffle, CheckCircle2, XCircle } from "lucide-astro";

const lang = "es";
const tkey = "course/verb-patterns/meaning-changers" as const;

const bigFour = [
  {
    verb: "stop",
    toDo: "I stopped to check my phone.",
    toNote: "hiciste una pausa para",
    ing: "I stopped checking my phone.",
    ingNote: "dejaste el hábito",
  },
  {
    verb: "remember",
    toDo: "Remember to send it.",
    toNote: "tarea futura",
    ing: "I remember sending it.",
    ingNote: "recuerdo del pasado",
  },
  {
    verb: "try",
    toDo: "I tried to open the file.",
    toNote: "lo intentaste y falló",
    ing: "Try opening it in another app.",
    ingNote: "prueba una solución",
  },
  {
    verb: "regret",
    toDo: "We regret to inform you…",
    toNote: "mala noticia formal, ahora",
    ing: "I regret telling him.",
    ingNote: "lamentas algo del pasado",
  },
];

const twoMore = [
  {
    verb: "forget",
    toDo: "I forgot to lock the door.",
    toNote: "no hiciste la tarea",
    ing: "I'll never forget meeting her.",
    ingNote: "recuerdo memorable",
  },
  {
    verb: "go on",
    toDo: "After sales, she went on to discuss hiring.",
    toNote: "tema nuevo",
    ing: "She went on talking for an hour.",
    ingNote: "siguió con la misma acción",
  },
];
---

<Base
  lang={lang}
  tkey={tkey}
  title="Cuando el Patrón Cambia el Significado: stop, remember, try | Patrones Verbales Lección 8"
  description="Lección 8 de Patrones Verbales. stop to do vs stop doing, remember/forget/try/regret — los verbos donde la forma cambia el significado, no solo la gramática."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <Shuffle class="w-4 h-4" />
          Nivel 3 · Maestría — Lección 8
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Cuando el Patrón Cambia el Significado
        </h1>
        <p class="text-2xl text-indigo-300 italic font-light mb-4">Mismo verbo, dos formas, dos significados.</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Con estos verbos, tanto <em class="text-white not-italic">to&nbsp;do</em> como
          <em class="text-white not-italic">-ing</em> son gramaticales — pero significan
          <strong class="text-white">cosas diferentes</strong>. Elegir la forma equivocada no es un
          descuido; dice algo completamente distinto.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección 1: los cuatro grandes -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Los cuatro grandes</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Lee los dos lados. Mismo verbo — la forma cambia el significado.</p>
        <div class="space-y-4">
          {bigFour.map((v) => (
            <div class="rounded-2xl border border-slate-200 overflow-hidden">
              <div class="bg-slate-50 px-5 py-2 border-b border-slate-200">
                <p class="text-sm font-mono font-semibold text-indigo-700">{v.verb}</p>
              </div>
              <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">to&nbsp;do — {v.toNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.toDo}</p>
                    <AudioButton client:visible text={v.toDo} lang="en-US" size="sm" />
                  </div>
                </div>
                <div class="p-5 bg-indigo-50/40">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">-ing — {v.ingNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.ing}</p>
                    <AudioButton client:visible text={v.ing} lang="en-US" size="sm" />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 2: dos más -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Dos más</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11"><em>forget</em> y <em>go on</em> siguen la misma lógica.</p>
        <div class="space-y-4">
          {twoMore.map((v) => (
            <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
              <div class="bg-slate-50 px-5 py-2 border-b border-slate-200">
                <p class="text-sm font-mono font-semibold text-indigo-700">{v.verb}</p>
              </div>
              <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">to&nbsp;do — {v.toNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.toDo}</p>
                    <AudioButton client:visible text={v.toDo} lang="en-US" size="sm" />
                  </div>
                </div>
                <div class="p-5 bg-indigo-50/40">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">-ing — {v.ingNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.ing}</p>
                    <AudioButton client:visible text={v.ing} lang="en-US" size="sm" />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 3: PatternDrill -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Ejercicio: ¿cuál significado?</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Ambas formas son gramaticales. Lee el significado y luego elige.</p>
        <PatternDrill client:visible data={l8Drill} lang="es" />
      </div>
    </div>
  </section>

  <!-- Sección 4: ErrorCorrection -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Encuentra el error</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Aquí la forma incorrecta da un significado incorrecto. Toca la parte que no encaja.</p>
        <ErrorCorrection client:visible data={l8Corrections} lang="es" />
      </div>
    </div>
  </section>

  <!-- Recap + siguiente -->
  <section class="py-16 md:py-20 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6 text-center">El resumen</h2>
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-8 mb-10">
          <ul class="space-y-3 text-slate-700">
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>to&nbsp;do</strong> mira hacia adelante — un propósito, una tarea futura, un intento o una frase formal fija.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>-ing</strong> mira hacia atrás o hacia adentro — un hábito, un recuerdo o algo que estás probando.</span></li>
            <li class="flex gap-3"><XCircle class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" /><span>Ambas son gramaticales, así que el corrector no te va a salvar — el <strong>significado</strong> es tu única guía.</span></li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-slate-600 mb-6">A continuación: <strong class="text-slate-900">Verbos de Reporte</strong> — cómo decir lo que dijo otra persona sin citarla palabra por palabra.</p>
          <Button href="/es/curso/patrones-verbales/verbos-de-reporte/" variant="primary" size="lg">
            Lección 9: Verbos de Reporte
            <ArrowRight class="w-5 h-5 ml-1" />
          </Button>
          <div class="mt-6">
            <a href="/es/curso/patrones-verbales/" class="text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2">← Volver al resumen del curso</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <CourseLessonSchema {lang} {tkey} />
</Base>
