---
export const prerender = true;

import Base from "@layouts/Base.astro";
import { courseOg } from "@/lib/courseOg";
import CourseLessonSchema from "@components/seo/CourseLessonSchema.astro";
import CollocationsDrill from "@components/course/collocations/CollocationsDrill.astro";
import { getGroups } from "@data/collocations/index";

const lang = "es";
const tkey = "course/verb-patterns/collocations-drill" as const;
const total = getGroups(lang).reduce((n, g) => n + g.items.length, 0);
---

<Base
  lang={lang}
  tkey={tkey}
  ogImage={courseOg("collocations", lang, "Las Palabras Correctas para el Trabajo")}
  title="Práctica de Preposiciones en Inglés de Negocios"
  description={`Escribe la preposición que falta en ${total} expresiones del inglés de negocios. Respuesta al instante, y lo que falles regresa en tu siguiente práctica.`}
>
  <CollocationsDrill lang={lang} />
  <CourseLessonSchema {lang} {tkey} />
</Base>
