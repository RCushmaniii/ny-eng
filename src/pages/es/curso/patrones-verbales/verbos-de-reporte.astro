---
export const prerender = true;

import Base from "@layouts/Base.astro";
import CourseLessonSchema from "@components/seo/CourseLessonSchema.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import PatternDrill from "@components/course/PatternDrill";
import ErrorCorrection from "@components/course/ErrorCorrection";
import { l9Drill, l9Corrections } from "@data/verb-patterns/lesson-9";
import { ArrowRight, Quote, CheckCircle2, XCircle } from "lucide-astro";

const lang = "es";
const tkey = "course/verb-patterns/reporting-verbs" as const;

const toDoReporters = [
  ["promise + to do", "The client promised to pay within thirty days.", "sin persona"],
  ["agree + to do", "We agreed to meet on Friday.", "sin persona"],
  ["offer + to do", "She offered to help me.", "sin persona"],
  ["refuse + to do", "He refused to sign the contract.", "sin persona"],
  ["remind someone + to do", "They reminded us to arrive early.", "requiere persona"],
  ["warn someone + to do", "She warned me to double-check the numbers.", "requiere persona"],
  ["advise someone + to do", "The lawyer advised him to wait.", "requiere persona"],
];
---

<Base
  lang={lang}
  tkey={tkey}
  title="Verbos de Reporte: say vs tell y la trampa de suggest | Patrones Verbales Lección 9"
  description="Lección 9 de Patrones Verbales. say vs tell y por qué 'suggest me to do' está mal. Reporta lo que dijeron sin los errores clásicos del hispanohablante."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <Quote class="w-4 h-4" />
          Nivel 3 · Maestría — Lección 9
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Reporting Verbs
        </h1>
        <p class="text-2xl text-indigo-300 italic font-light mb-4">Un verbo en español, dos patrones en inglés.</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Reportar lo que dijeron otras personas confunde a los hispanohablantes porque
          <em class="text-white not-italic">decir</em> corresponde tanto a <em class="text-white not-italic">say</em> como a
          <em class="text-white not-italic">tell</em> — y el inglés los mantiene separados. Súmale la trampa de
          <em class="text-white not-italic">suggest</em>/<em class="text-white not-italic">recommend</em>,
          y una sola oración descuidada te delata. Vamos a resolverlo todo.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección 1: Say vs Tell -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Say vs Tell</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Un verbo en español, dos reglas en inglés.</p>
        <div class="space-y-4 text-lg text-slate-700 leading-relaxed">
          <p>
            <strong>TELL</strong> lleva persona: <em>tell someone</em>. <strong>SAY</strong> no —
            <em>say that…</em>, o <em>say something to someone</em>. El oyente es toda la diferencia:
          </p>
          <div class="grid sm:grid-cols-2 gap-4 my-4">
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">tell + persona</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">She told me that she was busy.</p>
                <AudioButton client:visible text="She told me that she was busy." lang="en-US" size="sm" />
              </div>
            </div>
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">say + that (sin persona)</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">She said that she was busy.</p>
                <AudioButton client:visible text="She said that she was busy." lang="en-US" size="sm" />
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
          <strong>Ojo:</strong> nunca <span class="line-through">said me</span>, nunca <span class="line-through">told that…</span> sin persona. Si nombras al oyente → <em>tell</em>. Sin oyente → <em>say</em>.
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 2: La trampa de suggest / recommend -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">La trampa de suggest / recommend</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">El error más común de toda la lección.</p>
        <div class="space-y-4 text-lg text-slate-700 leading-relaxed">
          <p>
            <strong>suggest</strong> y <strong>recommend</strong> llevan <em>DOING</em>, o una cláusula con
            <em>that</em> — <strong>nunca</strong> una persona + <em>to do</em>. El español
            <em>me sugirió hacer</em> te empuja hacia el inglés incorrecto:
          </p>
          <div class="grid sm:grid-cols-2 gap-4 my-4">
            <div class="rounded-xl border-2 border-amber-200 bg-amber-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-amber-700 mb-1">suggest + doing</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">I suggested waiting until Friday.</p>
                <AudioButton client:visible text="I suggested waiting until Friday." lang="en-US" size="sm" />
              </div>
            </div>
            <div class="rounded-xl border-2 border-amber-200 bg-amber-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-amber-700 mb-1">suggest + that sb do</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">I suggested that he wait.</p>
                <AudioButton client:visible text="I suggested that he wait." lang="en-US" size="sm" />
              </div>
            </div>
          </div>
          <div class="rounded-xl border-2 border-red-200 bg-red-50 p-5">
            <div class="flex items-center gap-2 mb-1">
              <XCircle class="w-5 h-5 text-red-600 shrink-0" />
              <p class="text-xs font-bold uppercase tracking-wider text-red-700">nunca digas esto</p>
            </div>
            <p class="text-slate-900 text-lg line-through decoration-red-400">I suggested him to wait.</p>
            <p class="text-sm text-red-700 mt-1">En inglés no existe "suggest sb to do". La misma regla aplica para <em>recommend</em>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 3: Los reporteros con to-do -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Los reporteros con to-do</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Estos verbos reportan una acción con <em>to do</em> — algunos necesitan persona, otros no.</p>
        <div class="space-y-4 text-lg text-slate-700 leading-relaxed mb-8">
          <p>
            <strong>promise, agree, offer, refuse</strong> llevan <em>to do</em> sin necesitar persona.
            <strong>remind, warn, advise</strong> necesitan primero una persona: <em>someone + to do</em>.
          </p>
          <div class="grid sm:grid-cols-2 gap-4 my-4">
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">verb + to do</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">She offered to help.</p>
                <AudioButton client:visible text="She offered to help." lang="en-US" size="sm" />
              </div>
            </div>
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">verb + person + to do</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">They reminded us to arrive early.</p>
                <AudioButton client:visible text="They reminded us to arrive early." lang="en-US" size="sm" />
              </div>
            </div>
          </div>
        </div>
        <div class="space-y-3">
          {toDoReporters.map(([p, s, note]) => (
            <div class="bg-white rounded-xl border border-slate-200 p-4">
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-mono text-indigo-700">{p}</p>
                <span class="text-xs text-slate-400">{note}</span>
              </div>
              <div class="flex items-center gap-2 mt-1">
                <p class="text-slate-800 flex-1">{s}</p>
                <AudioButton client:visible text={s} lang="en-US" size="sm" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 4: PatternDrill -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Ejercicio: repórtalo bien</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">¿say o tell, doing o to do? Elige y verifica.</p>
        <PatternDrill client:visible data={l9Drill} lang="es" />
      </div>
    </div>
  </section>

  <!-- Sección 5: ErrorCorrection -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">5</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Encuentra el error</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Toca la parte incorrecta de cada oración.</p>
        <ErrorCorrection client:visible data={l9Corrections} lang="es" />
      </div>
    </div>
  </section>

  <!-- Recap + siguiente -->
  <section class="py-16 md:py-20 bg-slate-50 border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6 text-center">El resumen</h2>
        <div class="bg-white rounded-2xl border border-slate-200 p-8 mb-10">
          <ul class="space-y-3 text-slate-700">
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>tell</strong> con persona; <strong>say</strong> sin persona — nunca <em>said me</em>, nunca <em>told that…</em>.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>suggest</strong> / <strong>recommend</strong> llevan <em>doing</em> o <em>that sb do</em> — nunca <em>suggest sb to do</em>.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>promise/agree/offer/refuse</strong> + <em>to do</em>; <strong>remind/warn/advise</strong> + <em>someone</em> + <em>to do</em>.</span></li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-slate-600 mb-6">A continuación: <strong class="text-slate-900">Sonar Natural</strong> — el pulido final que separa el inglés correcto del inglés que suena nativo.</p>
          <Button href="/es/curso/patrones-verbales/sonar-natural/" variant="primary" size="lg">
            Lección 10: Sonar Natural
            <ArrowRight class="w-5 h-5 ml-1" />
          </Button>
          <div class="mt-6">
            <a href="/es/curso/patrones-verbales/" class="text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2">← Volver al resumen del curso</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <CourseLessonSchema {lang} {tkey} />
</Base>
