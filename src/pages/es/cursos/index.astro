---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import { courseInfo, units } from "@data/course/units";
import { elementaryInfo, elementaryUnits } from "@data/elementary/units";
import { intermediateInfo, intermediateUnits } from "@data/intermediate/units";
import { advancedInfo, advancedUnits } from "@data/advanced/units";
import { executiveInfo, executiveUnits } from "@data/executive/units";
import { driveInfo, scenarioMeta } from "@data/drive-the-decision/scenarios";
import { pushbackInfo, pushbackLessons } from "@data/executive-pushback/lessons";
import TestimonialCard from "@components/ui/TestimonialCard.astro";
import { testimonials } from "@data/testimonials/es";
import {
  Sparkles,
  BookOpen,
  Puzzle,
  Crown,
  ArrowRight,
  CheckCircle2,
  GraduationCap,
  Target,
  Zap,
  Search,
} from "lucide-astro";

const lang = "es";
const tkey = "courses" as const;

const beginnerAvailable = units.length;
const elementaryAvailable = elementaryUnits.filter((u) => u.published).length;
const elementaryTotal = elementaryUnits.length;
const intermediateAvailable = intermediateUnits.length;
const advancedAvailable = advancedUnits.length;
const executiveAvailable = executiveUnits.filter((u) => u.published).length;
const driveScenariosAvailable = scenarioMeta.filter((s) => s.available).length;
const pushbackLessonsAvailable = pushbackLessons.filter((l) => l.available).length;

// Selector rápido del hero — ruta directa a cada nivel
const levelSelector = [
  { label: "A1 · Principiante", sub: "El inglés se siente totalmente nuevo", href: "/es/curso/principiantes/" },
  { label: "A2 · Elemental", sub: "Habla de ayer y de tus planes", href: "/es/curso/elemental/" },
  { label: "B1–B2 · Intermedio", sub: "Deja de traducir en tu cabeza", href: "/es/curso/intermedio/" },
  { label: "B2–C1 · Avanzado", sub: "Fluido — ahora, pulido", href: "/es/curso/avanzado/" },
  { label: "C1–C2 · Ejecutivo", sub: "Lidera la sala en inglés", href: "/es/curso/ejecutivo/" },
];

// Prueba real de clientes, tomada de los testimonios (sin números inventados)
const featuredAuthors = ["Julio Aldana", "Hugo Blum", "Andres Guzman Rubio"];
const featuredTestimonials = featuredAuthors
  .map((name) => testimonials.find((t) => t.author === name))
  .filter((t): t is (typeof testimonials)[number] => Boolean(t));

// FAQ — apunta a búsquedas de alto volumen sobre cursos gratis / principiantes
const faqs = [
  {
    q: "¿De verdad son gratis estos cursos de inglés?",
    a: "Sí. Todos los cursos — de A1 principiante a C2 ejecutivo — son completamente gratuitos. Sin registro, sin tarjeta de crédito, sin barreras y sin pruebas que se vencen. Puedes empezar cualquier lección ahora mismo.",
  },
  {
    q: "¿Cómo puede un hispanohablante aprender inglés desde cero?",
    a: "Empieza con el curso principiante (A1). En lugar de memorizar listas, arranca con las más de 1,500 palabras en inglés que ya están escondidas en tu español (los cognados) y construye oraciones reales desde la primera lección. Para la Unidad 10 sostienes una conversación básica.",
  },
  {
    q: "¿Con cuál curso gratis de inglés debe empezar un principiante?",
    a: "Si el inglés se siente totalmente nuevo, empieza con el curso A1 Principiante. Si ya conoces lo básico pero todavía no puedes hablar del pasado ni hacer planes, toma A2 Elemental. Si ya sostienes una conversación, salta a B1–B2 Intermedio.",
  },
  {
    q: "¿De verdad puedo aprender inglés en línea gratis sin instalar ninguna app?",
    a: "Sí. Todo funciona en tu navegador — no hay nada que descargar. Cada lección es interactiva, con audio para cada palabra y frase y una autoevaluación para fijar lo aprendido. Tu progreso se guarda automáticamente en tu dispositivo.",
  },
  {
    q: "¿Cuánto tardo en aprender inglés con estos cursos?",
    a: "Depende de qué tan seguido practiques, pero cada ruta por nivel son 10 unidades cortas más un examen final. Practicando algunas veces por semana, la mayoría avanza un nivel en un par de meses — y sientes progreso real desde la primera lección.",
  },
  {
    q: "¿Quién hace estos cursos?",
    a: "Los crea Robert Cushman, un maestro de inglés de Nueva York que asesora a ejecutivos y profesionales uno a uno. Los mismos métodos detrás de su coaching privado dan forma a cada curso gratuito aquí.",
  },
  // Absorbidas del post retirado /es/blog/cursos-ingles-gratis-hispanohablantes/
  // al consolidarlo en este hub (2026-07-25). Las dos páginas competían por el
  // mismo grupo de búsquedas y se repartían la señal de posicionamiento.
  {
    q: "¿Qué tipo de voz se usa en el audio? ¿Es una persona real?",
    a: "Cada frase de ejemplo usa audio en inglés americano claro y natural, grabado a velocidad de conversación y no en cámara lenta como en la mayoría de las apps. Eso importa: si sólo practicas con audio lento, las juntas reales te van a seguir sonando rapidísimas. Escuchas el ritmo, el acento y las uniones entre palabras tal como las diría un nativo.",
  },
  {
    q: "¿Puedo llevar más de un curso al mismo tiempo?",
    a: "Sí, y a mucha gente le funciona mejor así. Una combinación común es un curso por nivel para tener estructura — de Principiante a Ejecutivo — más una clase enfocada como Patrones Verbales o Tiempos del Pasado para un punto débil específico. Nada está bloqueado, no hay un orden obligatorio y no pierdes avance al moverte entre cursos.",
  },
];

// Provider + oferta gratuita reutilizados en cada Course
const courseProvider = {
  "@type": "Organization",
  "@id": "https://www.nyenglishteacher.com/#org",
  name: "New York English Teacher",
  url: "https://www.nyenglishteacher.com/",
};
const freeOffer = {
  "@type": "Offer",
  category: "Free",
  price: "0",
  priceCurrency: "USD",
  availability: "https://schema.org/InStock",
};

const courseList = [
  {
    name: "Curso Gratis de Inglés (Principiante, A1)",
    url: "https://www.nyenglishteacher.com/es/curso/principiantes/",
    description:
      "Curso gratuito e interactivo de nivel A1 para hispanohablantes. Empieza con las más de 1,500 palabras en inglés escondidas en tu español y llega a una conversación real para la Unidad 10.",
    workload: "PT10H",
  },
  {
    name: "Curso Elemental de Inglés Gratis (A2)",
    url: "https://www.nyenglishteacher.com/es/curso/elemental/",
    description:
      "El puente gratuito de principiante a intermedio: pasado, planes futuros, comparativos y las preguntas que convierten respuestas de sí/no en conversación real.",
    workload: "PT10H",
  },
  {
    name: "Curso Gratis de Inglés Intermedio (B1–B2)",
    url: "https://www.nyenglishteacher.com/es/curso/intermedio/",
    description:
      "Curso gratuito B1–B2 que recablea el hábito de traducir en tu cabeza. Phrasal verbs, condicionales y los patrones naturales que de verdad usan los nativos.",
    workload: "PT12H",
  },
  {
    name: "Curso Avanzado de Inglés (B2–C1)",
    url: "https://www.nyenglishteacher.com/es/curso/avanzado/",
    description:
      "Curso gratuito B2–C1 de drills enfocados que corrigen los errores exactos de los hispanohablantes avanzados — artículos, trampas de palabras y detalles de pronunciación.",
    workload: "PT12H",
  },
  {
    name: "Curso Ejecutivo de Inglés (C1–C2)",
    url: "https://www.nyenglishteacher.com/es/curso/ejecutivo/",
    description:
      "La versión gratuita y productizada del coaching ejecutivo 1-a-1 de Robert: drills hablados, marcos con nombre y el lenguaje preciso que señala mando.",
    workload: "PT15H",
  },
  {
    name: "Domina los Tiempos del Pasado en Inglés (Clase Magistral Gratis)",
    url: "https://www.nyenglishteacher.com/es/curso/tiempos-del-pasado/",
    description:
      "Clase magistral gratuita que recablea la elección de tiempos del pasado mediante visualización, no memorización. Seis lecciones más guía rápida y plan de 30 días.",
    workload: "PT4H",
  },
  {
    name: "Dirige la Decisión — Simulación de Junta Directiva (Clase Magistral Gratis)",
    url: "https://www.nyenglishteacher.com/es/curso/dirige-la-decision/",
    description:
      "Clase magistral ejecutiva gratuita: diez escenarios de junta trabajados con respuestas modelo y la psicología de decisión detrás de cada una, más un drill de reflejo de 12 items.",
    workload: "PT5H",
  },
  {
    name: "Manejo de Pushback y Objeciones Ejecutivas (Clase Magistral Gratis)",
    url: "https://www.nyenglishteacher.com/es/curso/pushback-ejecutivo/",
    description:
      "Clase magistral gratuita para leer el impulsor real debajo de una objeción y responder con estructura en lugar de defensividad: Reconoce, Clarifica, Redirige.",
    workload: "PT4H",
  },
  {
    name: "Dominio de Patrones Verbales en Inglés (Clase Magistral Gratis)",
    url: "https://www.nyenglishteacher.com/es/curso/patrones-verbales/",
    description:
      "Clase magistral gratuita sobre los patrones verbales del inglés para hispanohablantes — patrones de objeto, verbo + preposición, gerundio vs infinitivo, causativos y verbos de reporte. Aprende cada verbo junto con su estructura.",
    workload: "PT6H",
  },
];

const courseItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Cursos Gratis de Inglés para Hispanohablantes",
  description:
    "Cursos de inglés gratuitos e interactivos para hispanohablantes — de A1 principiante a C2 ejecutivo. Sin registro ni barreras.",
  url: "https://www.nyenglishteacher.com/es/cursos/",
  itemListElement: courseList.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Course",
      name: c.name,
      description: c.description,
      url: c.url,
      inLanguage: "es",
      isAccessibleForFree: true,
      provider: courseProvider,
      offers: freeOffer,
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: "online",
        courseWorkload: c.workload,
      },
    },
  })),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  lang={lang}
  tkey={tkey}
  title="Cursos Gratis de Inglés para Hispanohablantes | NY English"
  description="Cursos de inglés gratuitos para hispanohablantes — de A1 principiante a C2 ejecutivo. Sin registro ni barreras. Hechos por un maestro de inglés de NY."
>
  <section class="bg-gradient-to-b from-slate-900 to-slate-800 pt-24 pb-20 md:pt-32 md:pb-24">
    <div class="site-container mx-auto px-4 text-white">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
       <div class="max-w-2xl">
        <div class="flex items-center gap-2 text-amber-400 text-sm font-semibold mb-3">
          <GraduationCap class="w-4 h-4" />
          Cursos Gratis
        </div>
        <h1
          class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight"
          style="font-family: 'Noto Sans KR', sans-serif;"
        >
          Cursos de Inglés que Realmente Funcionan para Hispanohablantes
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Nueve cursos gratuitos e interactivos hechos para hispanohablantes —
          cinco rutas por nivel, de A1 principiante a C2 ejecutivo, más cuatro
          clases magistrales enfocadas: patrones verbales, tiempos del pasado,
          comunicación ejecutiva de decisión y manejo de pushback ejecutivo. Sin
          registro. Sin barreras. Solo progreso real desde la primera lección.
        </p>
       </div>
       <div class="w-full">
         <div class="rounded-2xl bg-white/5 border border-white/10 p-5 sm:p-6 backdrop-blur-sm">
           <p class="text-amber-300 text-sm font-semibold mb-1">Empieza donde estás</p>
           <p class="text-slate-400 text-sm mb-4">Elige tu nivel y entra directo — sin registro.</p>
           <div class="flex flex-col gap-2">
             {levelSelector.map((lvl) => (
               <a
                 href={lvl.href}
                 class="group/lvl flex items-center justify-between gap-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-300/50 px-4 py-3 transition-all"
               >
                 <span class="min-w-0">
                   <span class="block text-white font-semibold text-sm">{lvl.label}</span>
                   <span class="block text-slate-400 text-xs">{lvl.sub}</span>
                 </span>
                 <ArrowRight class="w-4 h-4 text-amber-300 shrink-0 transition-transform group-hover/lvl:translate-x-0.5" />
               </a>
             ))}
           </div>
         </div>
       </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Beginner -->
        <a
          href="/es/curso/principiantes/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-amber-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-emerald-100 text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles class="w-3.5 h-3.5" />
              Nivel A1 — Principiante
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {courseInfo.titleEs}
            </h2>
            <p class="text-emerald-50 text-sm leading-relaxed">
              {courseInfo.taglineEs}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              La mayoría de los cursos hacen que los hispanohablantes empiecen
              desde cero. Nosotros no. Ya conoces más de 1,500 palabras en
              inglés — están escondidas en tu español. Para la Unidad 10,
              sostienes una conversación real.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>10 unidades interactivas + examen final</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Más de 1,500 cognados inglés/español</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Audio para cada palabra y frase</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">
                {beginnerAvailable} unidades disponibles
              </span>
              <span class="inline-flex items-center gap-1 text-amber-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Empezar curso
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Elementary -->
        <a
          href="/es/curso/elemental/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-sky-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-sky-500 to-sky-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-sky-100 text-xs font-bold uppercase tracking-wider mb-2">
              <BookOpen class="w-3.5 h-3.5" />
              Nivel A2 — Elemental
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {elementaryInfo.titleEs}
            </h2>
            <p class="text-sky-50 text-sm leading-relaxed">
              De fragmentos a historias completas — pasado, presente y futuro de tu vida real.
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              El puente del nivel principiante al intermedio. Pasado, planes
              futuros, comparar cosas, y las preguntas que convierten respuestas
              de "sí/no" en conversación real. Para la Unidad 10, cuentas tu
              propia historia.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                <span>Pasado simple — verbos regulares e irregulares</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                <span>Going to + will, comparativos, cuantificadores</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                <span>Reto final: una historia de 60 segundos sobre tu vida</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">
                {elementaryAvailable > 0
                  ? `${elementaryAvailable} de ${elementaryTotal} unidades disponibles`
                  : "Próximamente · construyendo ahora"}
              </span>
              <span class="inline-flex items-center gap-1 text-sky-600 font-semibold text-sm group-hover:gap-2 transition-all">
                {elementaryAvailable > 0 ? "Empezar curso" : "Vista previa"}
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Intermediate -->
        <a
          href="/es/curso/intermedio/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-amber-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-amber-500 to-amber-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-amber-100 text-xs font-bold uppercase tracking-wider mb-2">
              <Puzzle class="w-3.5 h-3.5" />
              Nivel B1–B2 — Intermedio
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {intermediateInfo.titleEs}
            </h2>
            <p class="text-amber-50 text-sm leading-relaxed">
              {intermediateInfo.taglineEs}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              Sostienes una conversación — pero cada oración pasa primero por
              el español. Este curso lo recablea. Phrasal verbs, condicionales
              y los patrones naturales que usan los nativos, practicados hasta
              que el inglés sale sin traducir.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Modales, condicionales y construcción de oraciones</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Inglés de oficina, viajes y vida social</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Corrige los errores exactos de los hispanohablantes</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-amber-600 uppercase tracking-wider">
                {intermediateAvailable} unidades disponibles
              </span>
              <span class="inline-flex items-center gap-1 text-amber-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Empezar curso
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Advanced -->
        <a
          href="/es/curso/avanzado/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-violet-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-violet-500 to-violet-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-violet-100 text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles class="w-3.5 h-3.5" />
              Nivel B2–C1 — Avanzado
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {advancedInfo.titleEs}
            </h2>
            <p class="text-violet-50 text-sm leading-relaxed">
              {advancedInfo.taglineEs}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              Tu inglés es fluido. No está pulido. Incluso a nivel C1, el
              artículo equivocado, el "fewer" perdido y la TH suave te delatan
              en los primeros treinta segundos. Drills que corrigen los errores
              exactos que persiguen a los hispanohablantes avanzados — sin
              temas, sin memorización.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-violet-500 shrink-0 mt-0.5" />
                <span>Frases fuertes y vocabulario de precisión</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-violet-500 shrink-0 mt-0.5" />
                <span>Artículos, pronombres, trampas de palabras — los errores de toda la vida</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-violet-500 shrink-0 mt-0.5" />
                <span>Detalles de pronunciación que te delatan</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-violet-600 uppercase tracking-wider">
                {advancedAvailable} unidades disponibles
              </span>
              <span class="inline-flex items-center gap-1 text-violet-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Empezar curso
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Executive -->
        <a
          href="/es/curso/ejecutivo/"
