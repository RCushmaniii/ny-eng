---
export const prerender = true;

import Base from "@layouts/Base.astro";
import InnerHero from "@components/sections/InnerHero.astro";
import Challenge from "@components/sections/Challenge.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import LeadMagnetCallout from "@components/sections/LeadMagnetCallout.astro";
import LeadMagnetForm from "@components/sections/LeadMagnetForm.astro";
import ServiceFAQ from "@components/sections/ServiceFAQ.astro";
import BreadcrumbSchema from "@components/seo/BreadcrumbSchema.astro";
import TestimonialCard from "@components/ui/TestimonialCard.astro";
import { serviceFaqs } from "@data/service-faqs";
import { paqueteCorporativo as serviceData } from "@data/services";
import { testimonials as esTestimonials } from "@data/testimonials/es";

const corporateTestimonial = esTestimonials.find(
  (t) => t.slug === "jose-antonio-lopez-terramar-brands",
);

/**
 * Nombres de empresas del listado de clientes.
 *
 * Filtrados contra los testimonios publicados, no escritos a mano: cada nombre
 * sólo aparece si esa empresa sigue teniendo un testimonio con nombre y cargo
 * publicado en el sitio. Si se retira un testimonio, el nombre desaparece solo
 * — que es justo el error que una lista fija dejaría pasar en silencio.
 */
const FEATURED_CLIENTS = [
  "Driscoll's",
  "Continental",
  "Sanmina Corporation",
  "CEVA Logistics",
  "Terramar Brands",
  "Grupo Kopar",
  "Smarttie",
  "100 Ladrillos",
];
const publishedCompanies = new Set(esTestimonials.map((t) => t.company).filter(Boolean));
const corporateClients = FEATURED_CLIENTS.filter((c) => publishedCompanies.has(c));

const title = "Inglés Corporativo de 12 Semanas para Equipos Directivos";
const seoDescription =
  "Tus gerentes ya saben inglés. Programa de 12 semanas para que presenten, respondan y defiendan sus ideas en inglés bajo presión profesional real.";

const heroContent = {
  title: "Tus gerentes ya hablan inglés. El reto empieza cuando la junta importa.",
  description:
    "Programa de 12 semanas para que tu equipo directivo presente, responda preguntas inesperadas y defienda una recomendación en inglés — frente a clientes de Norteamérica, colegas y liderazgo internacional — con la misma autoridad que ya tiene en español.",
  backgroundImage: serviceData.backgroundImage,
  overlayOpacity: 0.75,
  imageAlt: "Equipo directivo en una sesión de coaching de inglés de negocios",
};

const challengeContent = {
  headline: "El problema no es el conocimiento del inglés. Es el desempeño en inglés bajo presión profesional.",
  painPoints: [
    "El inglés de tu equipo funciona en el correo y en la llamada de rutina. Cambia cuando llega una pregunta que nadie anticipó, cuando hay que sostener una postura o cuando la conversación se acelera: la respuesta se simplifica, la idea pierde matiz y la persona suena menos experimentada de lo que realmente es.",
    "Frente a un cliente de Estados Unidos o Canadá el costo es directo. El mismo gerente que en español proyecta criterio y autoridad puede sonar menos decidido, menos senior y menos informado — no por falta de capacidad, sino porque el idioma le quita velocidad de respuesta en el momento exacto en que la necesita.",
    "Un curso de inglés entrena el conocimiento, no el momento. Se puede aprobar cualquier examen y seguir sin poder defender una recomendación en inglés cuando hay cinco personas esperando la respuesta.",
  ],
  icon: "💡",
  image: serviceData.squareImage,
  imageAlt: "Profesional ejecutivo practicando presentaciones en inglés bajo presión",
  quizCta: {
    text: "Realiza la Evaluación de Comunicación Ejecutiva — 60 segundos.",
    link: "/es/quiz/executives/question/1/",
    linkLabel: "Iniciar la Evaluación →",
  },
};

const ctaContent = {
  eyebrow: "Programas Corporativos",
  title: "¿Listo para construir un equipo directivo que lidere en inglés?",
  description:
    "Este programa requiere una llamada de descubrimiento para definir el alcance según el tamaño de tu grupo, agenda y objetivos. Robert es neoyorquino de nacimiento y lleva más de una década entrenando ejecutivos y equipos directivos en todo México. Responde en 24 horas.",
  buttonSubtext: "La mayoría de las llamadas de descubrimiento duran 30 minutos.",
  buttonText: "Agendar Llamada de Descubrimiento",
  buttonLink: "/es/reservar/",
  secondaryButtonText: "Contactar a Robert por WhatsApp",
  secondaryButtonLink: "https://wa.me/523315590572",
  whatToExpectTitle: "En Tu Llamada de Descubrimiento:",
  whatToExpectList: [
    "Identificaremos en qué situaciones concretas el inglés de tu equipo pierde autoridad",
    "Definiremos el alcance del programa para tu tamaño de grupo, agenda y contexto de industria",
    "Estableceremos cómo se ve un resultado exitoso para tu equipo",
  ],
};

const faqs = serviceFaqs["corporate-package"]?.es || [];
---

<Base
  title={title}
  description={seoDescription}
  lang="es"
  tkey="services/corporate-package"
  hideCta={true}
>
  <!-- Hero -->
  <InnerHero content={heroContent} />

  <!-- Listado de clientes — lo primero que busca quien evalúa por referencia -->
  {corporateClients.length > 0 && (
    <section class="bg-white pt-12 pb-4 px-8">
      <div class="site-container--small mx-auto">
        <p class="text-center text-sm text-gray-500 mb-6">
          Este programa se entregó al equipo de gerentes de Terramar Brands. Líderes de estas
          empresas han trabajado conmigo uno a uno.
        </p>
        <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3">
          {corporateClients.map((name) => (
            <li class="text-gray-700 font-semibold tracking-tight">{name}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Challenge -->
  <Challenge content={challengeContent} background="white" padding="lg" />

  <!-- Lead Magnet Callout (subtle early touchpoint) -->
  <LeadMagnetCallout lang="es" />

  <!-- Estructura del Programa -->
  <section class="bg-light py-16 px-8">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-2 text-center">Cómo Funciona el Programa</h2>
      <p class="text-center text-gray-600 mb-12">12 semanas en 3 fases. Sesiones 1-a-1 con un coach neoyorquino, construidas sobre las juntas, llamadas y presentaciones que tu equipo ya tiene en la agenda — y una prueba real de desempeño al final.</p>

      <div class="grid gap-8 md:grid-cols-3">
        <!-- Fase 1 -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Semanas 1–8</div>
          <h3 class="text-xl font-bold mb-3">Fase 1 — Evaluación Individual y Preparación</h3>
          <p class="text-gray-600 mb-4">Cada participante trabaja en privado con Robert. Las semanas 1–2 establecen una línea base honesta de cómo cambia su inglés cuando sube la presión. Las semanas 3–8 son ensayo dirigido sobre sus situaciones reales: sus juntas, sus llamadas con clientes de Norteamérica, la presentación que ya trae en la agenda, y las preguntas incómodas que puede recibir en cualquiera de ellas.</p>
          <div class="text-sm text-gray-500">
            <strong>8–12 sesiones por participante</strong><br />
            4,800 – 7,200 MXN
          </div>
        </div>

        <!-- Fase 2 -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Semanas 9–10</div>
          <h3 class="text-xl font-bold mb-3">Fase 2 — Desempeño frente al Equipo Directivo</h3>
          <p class="text-gray-600 mb-4">Cada participante presenta en inglés frente al grupo directivo completo y responde preguntas en vivo — muchas veces por primera vez. No hay opción de cambiar al español, igual que en la junta real. La presión es deliberada y es el punto: es la única forma de entrenar el momento que un curso no toca.</p>
          <div class="text-sm text-gray-500">
            <strong>1–2 sesiones grupales</strong><br />
            600 – 1,200 MXN por participante
          </div>
        </div>

        <!-- Fase 3 -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Semanas 11–12</div>
          <h3 class="text-xl font-bold mb-3">Fase 3 — Lecciones Aprendidas y Evaluación Final</h3>
          <p class="text-gray-600 mb-4">Sesiones individuales de debrief con retroalimentación directa y honesta sobre lo que se sostuvo bajo presión y lo que se cayó. Una evaluación final mide el progreso contra la línea base de las semanas 1–2. Cada participante recibe un plan de ruta escrito. La empresa recibe un reporte de progreso consolidado.</p>
          <div class="text-sm text-gray-500">
            <strong>2–3 sesiones por participante</strong><br />
            1,200 – 1,800 MXN
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Entregables de las Revisiones Formales -->
  <section class="bg-white py-16 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-2 text-center">Qué Incluyen las Revisiones Formales</h2>
      <p class="text-center text-gray-600 mb-12 max-w-xl mx-auto">Esto es lo que separa al programa estructurado del coaching flexible. Tres entregables formales por participante, más un reporte a nivel empresa.</p>

      <div class="grid gap-6 md:grid-cols-2 max-w-4xl mx-auto">

        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Se entrega tras la sesión 1–2</div>
          <h3 class="text-xl font-bold mb-3">Perfil Inicial del Participante</h3>
          <p class="text-gray-600 text-sm mb-4">Un documento escrito de línea base para cada participante, elaborado después de la primera sesión. Cubre:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Nivel actual de inglés y patrones de comunicación observables</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Puesto, responsabilidades y contexto de equipo</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Objetivos de inglés ligados al puesto y sus momentos de comunicación críticos</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Áreas de enfoque prioritarias para las Fases 1–3</li>
          </ul>
          <p class="text-xs text-gray-400 mt-4">Este documento es la línea base del programa. La Fase 3 mide el progreso contra él.</p>
        </div>

        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Se entrega cada mes durante el programa</div>
          <h3 class="text-xl font-bold mb-3">Evaluaciones Mensuales</h3>
          <p class="text-gray-600 text-sm mb-4">Una evaluación por participante por mes. Cada una cubre cinco áreas:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Brechas vigentes</strong> — los patrones de comunicación que siguen apareciendo y que más importan</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Nivel de esfuerzo</strong> — calidad de la preparación y práctica fuera de sesión, evaluada con honestidad</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Entusiasmo y participación</strong> durante las sesiones</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Desempeño en sesión</strong> — fluidez, claridad y seguridad bajo presión</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Prioridades actualizadas</strong> con base en el trabajo reciente</span></li>
          </ul>
          <p class="text-xs text-gray-400 mt-4">Las sesiones nunca se graban con IA. Todo el contenido de evaluación proviene de la observación directa de Robert.</p>
        </div>

        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Al cierre del programa — por participante</div>
          <h3 class="text-xl font-bold mb-3">Hoja de Ruta Individual Escrita</h3>
          <p class="text-gray-600 text-sm mb-4">Un documento personalizado para cada participante que cubre:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Progreso medido contra la línea base inicial</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Brechas prioritarias restantes y cómo trabajarlas</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Áreas de enfoque y formas de práctica recomendadas para seguir avanzando</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Un resumen honesto de dónde queda esa persona al terminar el programa</li>
          </ul>
        </div>

        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Al cierre del programa — para la empresa</div>
          <h3 class="text-xl font-bold mb-3">Reporte Consolidado para la Empresa</h3>
          <p class="text-gray-600 text-sm mb-4">Un documento a nivel resumen para revisión de RH y dirección, que cubre:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Progreso del equipo y patrones colectivos observados</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Logros y avances destacados en el grupo</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Recomendaciones para el desarrollo continuo del equipo</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Panorama de los resultados del programa contra los objetivos originales</li>
          </ul>
          <p class="text-xs text-gray-400 mt-4">El detalle de desempeño individual se queda en las hojas de ruta personales, no en el reporte de la empresa.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Inversión -->
  <section class="bg-white py-16 px-8">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-2 text-center">Inversión</h2>
      <p class="text-center text-gray-600 mb-10">600 MXN por sesión por participante. Facturas mexicanas emitidas mensualmente.</p>

      <div class="max-w-2xl mx-auto bg-gray-50 rounded-xl p-8 border border-gray-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left pb-3 font-semibold">Escenario</th>
              <th class="text-right pb-3 font-semibold">Por Participante</th>
              <th class="text-right pb-3 font-semibold">Equipo de 5</th>
            </tr>
          </thead>
          <tbody class="text-gray-600">
            <tr class="border-b border-gray-100">
              <td class="py-3">Conservador (12 sesiones)</td>
              <td class="text-right py-3">7,200 MXN</td>
              <td class="text-right py-3">≈ 36,000 MXN</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-3">Moderado (14–15 sesiones)</td>
              <td class="text-right py-3">8,400 – 9,000 MXN</td>
              <td class="text-right py-3">≈ 42,000–45,000 MXN</td>
            </tr>
            <tr>
              <td class="py-3">Intensivo (17 sesiones)</td>
              <td class="text-right py-3">10,200 MXN</td>
              <td class="text-right py-3">≈ 51,000 MXN</td>
            </tr>
          </tbody>
        </table>
        <p class="text-xs text-gray-400 mt-4">El total varía porque las agendas varían — no todos los participantes asisten a todas las sesiones posibles. Precios en USD disponibles para empresas internacionales.</p>
      </div>

      <div class="max-w-2xl mx-auto mt-6 bg-gray-50 border border-gray-200 rounded-xl p-6 text-sm text-gray-600">
        <strong class="text-gray-900">Qué incluye la tarifa corporativa que el coaching individual no incluye.</strong>
        Mi coaching privado 1-a-1 cuesta 500 MXN por sesión y es exactamente eso: la sesión. La
        tarifa corporativa de 600 MXN agrega la sesión de presentación frente al grupo de
        liderazgo, la evaluación inicial y la final contra esa línea base, las evaluaciones
        mensuales por escrito, la hoja de ruta individual de cada participante y el reporte
        consolidado para RH y dirección. Si lo que tu equipo necesita son sesiones sueltas sin esa
        capa de medición y reporteo, el coaching individual es la opción correcta y cuesta menos.
      </div>

      <div class="max-w-2xl mx-auto mt-6 bg-amber-50 border border-amber-200 rounded-xl p-6 text-sm text-amber-900">
        <strong>Los resultados dependen del compromiso individual.</strong> El programa está diseñado para crear avances — pero los avances requieren preparación entre sesiones, participación honesta con la retroalimentación y disposición a actuar bajo presión. Los participantes que se preparan seriamente típicamente ven ganancias de desempeño significativas. Los que asisten pero no se preparan verán resultados limitados.
      </div>
    </div>
  </section>

  <!-- Testimonio de Cliente -->
  {corporateTestimonial && (
    <section class="bg-white py-16 px-8 border-t border-gray-100">
      <div class="site-container--small mx-auto max-w-2xl">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2 text-center">De un cliente reciente</p>
        <h2 class="text-3xl font-bold mb-10 text-center">Lo que dice Recursos Humanos</h2>
        <TestimonialCard testimonial={corporateTestimonial} showHeadline={true} showReadMore={false} />
      </div>
    </section>
  )}

  <!-- Cómo lo evalúan las empresas — las preguntas reales de quien llega por referencia -->
  <section class="bg-white py-16 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold mb-2 text-center">Cómo lo evalúan las empresas</h2>
      <p class="text-center text-gray-600 mb-10">
        La mayoría de las empresas con las que trabajo llegaron por recomendación de alguien que ya
        estaba en sesiones. Así se ve la evaluación desde tu lado.
      </p>

      <div class="space-y-6">
        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold text-lg mb-2">1. Una clase demo, y tú la observas</h3>
          <p class="text-gray-600 text-sm">
            Antes de cualquier compromiso, alguien de tu equipo toma una sesión real y tú la
            observas. No es una llamada de ventas ni una clase de muestra armada para el demo: es
            una sesión sobre el trabajo real de esa persona. Vas a ver el coaching, el estilo de
            corrección y cómo responde tu colega, y decides desde ahí.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold text-lg mb-2">2. Facturación que tu área de finanzas puede procesar</h3>
          <p class="text-gray-600 text-sm">
            Facturo con RFC mexicano y emito facturas mensuales por las sesiones efectivamente
            impartidas. También hay facturación en dólares para empresas que facturan fuera de
            México. Si compras o proveeduría necesita los datos fiscales para dar de alta al
            proveedor, pídelos y te los mando.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold text-lg mb-2">3. El precio no baja por volumen</h3>
          <p class="text-gray-600 text-sm">
            No hay descuento por volumen, y prefiero decirlo desde el principio en lugar de que
            aparezca al final. Cada sesión se construye para el puesto de una persona y su próximo
            momento de presión real, así que cinco participantes son cinco preparaciones distintas,
            no una clase repetida cinco veces. La tarifa refleja eso.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Resultados -->
  <section class="bg-light py-16 px-8">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-10 text-center">Qué Produce Este Programa</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="font-bold text-lg mb-4">Para Cada Participante</h3>
          <p class="text-sm text-gray-500 mb-4">El objetivo no es "más seguridad" en abstracto. Es desempeño observable: al cerrar el programa, cada participante puede hacer estas cosas en inglés.</p>
          <ul class="space-y-3 text-gray-600">
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Presentar una idea con estructura y llegar al punto, sin rodeos ni relleno</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Responder una pregunta que no anticipó sin perder el hilo ni bajar el registro</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Explicar y defender una recomendación frente a alguien que no está de acuerdo</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Sostener una conversación directa con un cliente de Estados Unidos o Canadá, sin intermediario</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Comunicar un problema o una mala noticia sin suavizarla hasta volverla ambigua</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Responder en tiempo real, sin traducir cada frase en la cabeza</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Un plan de ruta escrito para seguir desarrollándose después del programa</li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Para la Empresa</h3>
          <ul class="space-y-3 text-gray-600">
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Un equipo directivo que puede representar a la empresa en inglés sin que nadie tenga que traducir, acompañar o rescatar la conversación</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Menos dependencia de la única persona del equipo que "sí habla bien inglés" para cada junta que importa</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Un reporte de progreso consolidado para RH y revisión ejecutiva</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> El inicio de un cambio cultural — de evitar el inglés a prepararse para él</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Un efecto secundario inesperado: los pares se ven mutuamente con nuevos ojos, cambiando la dinámica en las reuniones reales</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Lead Magnet Form (conversion surface before final CTA) -->
  <LeadMagnetForm lang="es" sourcePage="/es/servicios/paquete-corporativo/" />

  <!-- CTA -->
  <CtaSection content={ctaContent} />

  <!-- FAQ -->
  <ServiceFAQ faqs={faqs} lang="es" />

  <!-- Enlace cruzado — Página de categoría (hub) -->
  <section class="bg-white py-12 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto max-w-3xl">
      <div class="border-l-4 border-gray-300 pl-8">
