---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import CourseProgress from "@components/course/CourseProgress";
import VerbUpgradeLab from "@components/course/VerbUpgradeLab";
import WeakStrongElite from "@components/course/WeakStrongElite";
import StructuredResponseBuilder from "@components/course/StructuredResponseBuilder";
import RapidRepeat from "@components/course/RapidRepeat";
import FinalShiftCard from "@components/course/FinalShiftCard";
import { executiveUnits } from "@data/executive/units";
import {
  unit10Sections,
  unit10Section1Drills,
  unit10Section2Drills,
  unit10Section3Drills,
  unit10FinalShift,
} from "@data/executive/unit-10";
import { ArrowRight, ArrowLeft, Crown } from "lucide-astro";

const lang = "en";
const tkey = "course/executive/unit-10" as const;
const unit = executiveUnits[9];

const progressUnits = executiveUnits
  .filter((u) => u.published)
  .map((u) => ({ id: u.id, slug: u.slug, title: u.title, titleEs: u.titleEs }));
---

<Base
  lang={lang}
  tkey={tkey}
  title={`Unit 10: ${unit.title} | NY English Teacher`}
  description={unit.seoDescription}
>
  <CourseProgress
    client:load
    units={progressUnits}
    currentUnit={10}
    basePath="/en/course/executive"
    lang="en"
    courseId="executive"
  />

  <!-- Unit hero -->
  <section class="bg-gradient-to-b from-slate-950 to-slate-900 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-amber-400 text-sm font-semibold mb-3">
          <Crown class="w-4 h-4" />
          Unit 10
        </div>
        <h1
          class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight"
          style="font-family: 'Noto Sans KR', sans-serif;"
        >
          {unit.title}
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          {unit.description}
        </p>
      </div>
    </div>
  </section>

  {/* SEO intro — server-rendered, indexable long-tail context */}
  <section class="py-10 bg-white border-b border-slate-100">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto space-y-4 text-slate-600 leading-relaxed">
        <p>This capstone unit answers the question every senior speaker eventually searches: how to sound like a leader in English consistently, not just on a good day. It integrates everything from the previous nine units — precise verbs, calibrated certainty, structure, controlled tone, and strategic narrative — into one coherent executive voice, then prepares your recorded presentation.</p>
        <p>After it, you will pull the full toolkit together under pressure and record a 90-second executive presentation, opening with a line like "here is where we are, and here is what I recommend." That recording goes to Robert for personal feedback. This is a free lesson from an executive English coach, and the bridge from self-study into one-on-one executive coaching.</p>
      </div>
    </div>
  </section>

  <!-- Section 1: Integration Review (VerbUpgradeLab) -->
  <section class="py-16 md:py-20 bg-white" id="section-1">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">{unit10Sections[0].title}</h2>
        </div>
        <p class="text-slate-500 mb-4 ml-11">{unit10Sections[0].why}</p>
        <div class="ml-11">
          <VerbUpgradeLab client:visible items={unit10Section1Drills} lang="en" />
        </div>
        <div class="mt-8 ml-11 space-y-4">
          <p class="text-sm font-semibold text-slate-600">{unit10Sections[0].techniqueFocus}</p>
          <RapidRepeat client:visible stems={unit10Sections[0].rapidRepeat} lang="en" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Personal Brand in English (WeakStrongElite) -->
  <section class="py-16 md:py-20 bg-slate-50" id="section-2">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">{unit10Sections[1].title}</h2>
        </div>
        <p class="text-slate-500 mb-4 ml-11">{unit10Sections[1].why}</p>
        <div class="ml-11">
          <WeakStrongElite client:visible items={unit10Section2Drills} lang="en" />
        </div>
        <div class="mt-8 ml-11 space-y-4">
          <p class="text-sm font-semibold text-slate-600">{unit10Sections[1].techniqueFocus}</p>
          <RapidRepeat client:visible stems={unit10Sections[1].rapidRepeat} lang="en" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Capstone Preparation (StructuredResponseBuilder) -->
  <section class="py-16 md:py-20 bg-white" id="section-3">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">{unit10Sections[2].title}</h2>
        </div>
        <p class="text-slate-500 mb-4 ml-11">{unit10Sections[2].why}</p>
        <div class="ml-11">
          <StructuredResponseBuilder client:visible items={unit10Section3Drills} lang="en" />
        </div>
        <div class="mt-8 ml-11 space-y-4">
          <p class="text-sm font-semibold text-slate-600">{unit10Sections[2].techniqueFocus}</p>
          <RapidRepeat client:visible stems={unit10Sections[2].rapidRepeat} lang="en" />
        </div>
      </div>
    </div>
  </section>

  <!-- Final Shift -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <FinalShiftCard client:visible shift={unit10FinalShift} lang="en" />
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <section class="py-12 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
        <a
          href="/en/course/executive/unit-9/"
          class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-amber-600 transition-colors"
        >
          <ArrowLeft class="w-4 h-4" />
          Unit 9: Negotiation & Driving Decisions
        </a>
        <Button href="/en/course/executive/capstone/" variant="primary" size="lg">
          Record Your Capstone Presentation
          <ArrowRight class="w-5 h-5 ml-1" />
        </Button>
      </div>
    </div>
  </section>
</Base>
