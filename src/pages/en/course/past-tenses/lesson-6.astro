---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import {
  ArrowRight,
  Map,
  Trophy,
  AlertTriangle,
  Eye,
  CheckCircle2,
  XCircle,
  Sparkles,
  Clock,
  Film,
  Link as LinkIcon,
  Layers,
  FileText,
  AlertCircle,
  Lightbulb,
  Mic,
  MessageSquare,
} from "lucide-astro";

const lang = "en";
const tkey = "course/past-tenses/lesson-6" as const;
---

<Base
  lang={lang}
  tkey={tkey}
  title="Lesson 6: The Story Flow Map — Capstone | NY English Teacher"
  description="The final lesson. Combine Past Simple, Past Continuous, Present Perfect, and Past Perfect like a native — choosing each tense by reading the shape of the story."
>
  <!-- Lesson hero -->
  <section class="bg-gradient-to-b from-slate-900 to-emerald-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-emerald-400 text-sm font-semibold mb-3">
          <Map class="w-4 h-4" />
          Lesson 6 of 6 — The Capstone
        </div>
        <h1
          class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight"
          style="font-family: 'Noto Sans KR', sans-serif;"
        >
          The Story Flow Map
        </h1>
        <p class="text-2xl text-emerald-300 italic font-light mb-4">Putting all four together — like a native.</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          You've learned the four tenses. Now you have to <em>choose</em> between them in real time —
          while your boss is waiting for an answer, while your client is on the call, while the words are coming out of your mouth.
          This lesson teaches the decision tree native speakers run unconsciously, and how to install it in your own instinct.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-sm font-medium">
            <Map class="w-3.5 h-3.5" /> The Decision Tree
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-sm font-medium">
            <Sparkles class="w-3.5 h-3.5" /> Worked Example
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-sm font-medium">
            <Trophy class="w-3.5 h-3.5" /> Course Capstone
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: The Story Flow Map -->
  <section class="py-16 md:py-20 bg-white" id="section-1">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The Story Flow Map</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">All four tenses on one mental canvas. The shape of the story tells you which one to reach for.</p>

        <div class="space-y-4">
          <div class="bg-emerald-50 border-2 border-emerald-300 rounded-2xl p-6 flex items-start gap-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-500 text-white shrink-0">
              <Clock class="w-6 h-6" />
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Past Simple — The Snapshot</p>
              <h3 class="text-lg font-bold text-slate-900 mb-1">Closed box. Sealed time.</h3>
              <p class="text-sm text-slate-700">A single completed event, or a sequence of events, with the time window sealed. Triggered by words like <em>yesterday, last week, in 2019</em>.</p>
            </div>
          </div>

          <div class="bg-emerald-50 border-2 border-emerald-300 rounded-2xl p-6 flex items-start gap-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-500 text-white shrink-0">
              <Film class="w-6 h-6" />
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Past Continuous — The Movie</p>
              <h3 class="text-lg font-bold text-slate-900 mb-1">In motion. Mid-action. Background scene.</h3>
              <p class="text-sm text-slate-700">An action that <em>was happening</em> when something else cut in. The camera frozen on a moment still unfolding. Triggered by <em>while, as, when (+ snapshot)</em>.</p>
            </div>
          </div>

          <div class="bg-emerald-50 border-2 border-emerald-300 rounded-2xl p-6 flex items-start gap-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-500 text-white shrink-0">
              <LinkIcon class="w-6 h-6" />
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Present Perfect — The Thread</p>
              <h3 class="text-lg font-bold text-slate-900 mb-1">Past leaks into now.</h3>
              <p class="text-sm text-slate-700">The time window is still open, OR the action is still going, OR the experience lives in you. Triggered by <em>today, this week, for/since, ever, never, already, just</em>.</p>
            </div>
          </div>

          <div class="bg-emerald-50 border-2 border-emerald-300 rounded-2xl p-6 flex items-start gap-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-500 text-white shrink-0">
              <Layers class="w-6 h-6" />
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Past Perfect — The Layer Below</p>
              <h3 class="text-lg font-bold text-slate-900 mb-1">Earlier than the main past moment.</h3>
              <p class="text-sm text-slate-700">A second past event that happened <em>before</em> the main past moment of your story. Triggered by <em>by the time, before, after, already (+ had), until</em>.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: The Decision Tree -->
  <section class="py-16 md:py-20 bg-slate-50" id="section-2">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The Decision Tree</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Four questions, in order. Run them in your head until the instinct takes over. This is what native speakers do unconsciously every time they open their mouth.</p>

        <div class="space-y-4">
          <div class="bg-white rounded-xl border-2 border-slate-200 p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-2">Question 1</p>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Did this event happen <em>before</em> another past moment in my story?</h3>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-3">
                <p class="font-semibold text-emerald-800">Yes →</p>
                <p class="text-slate-700">Past Perfect (<em>had + pp</em>)</p>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                <p class="font-semibold text-slate-600">No →</p>
                <p class="text-slate-700">Continue to Question 2</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border-2 border-slate-200 p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-2">Question 2</p>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Is the moment still connected to now (open time, still going, life experience)?</h3>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-3">
                <p class="font-semibold text-emerald-800">Yes →</p>
                <p class="text-slate-700">Present Perfect (<em>have/has + pp</em>)</p>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                <p class="font-semibold text-slate-600">No →</p>
                <p class="text-slate-700">Continue to Question 3</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border-2 border-slate-200 p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-2">Question 3</p>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Was the action in progress when something else happened, or setting the scene?</h3>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-3">
                <p class="font-semibold text-emerald-800">Yes →</p>
                <p class="text-slate-700">Past Continuous (<em>was/were + verb-ing</em>)</p>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                <p class="font-semibold text-slate-600">No →</p>
                <p class="text-slate-700">Continue to Question 4</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border-2 border-emerald-400 p-6 shadow-md">
            <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-2">Default — Question 4</p>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Single closed event in sealed past time?</h3>
            <div class="grid grid-cols-1 gap-3 text-sm">
              <div class="bg-emerald-100 border border-emerald-300 rounded-lg p-3">
                <p class="font-semibold text-emerald-800">→ Past Simple (<em>did, went, worked</em>)</p>
                <p class="text-slate-700 mt-1">If you've run through the first three questions and none of them fit, you're almost always in Past Simple territory. It's the workhorse — but only when nothing else applies.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 bg-amber-50 border-2 border-amber-300 rounded-xl p-5">
          <p class="text-sm text-amber-900"><strong>The Mexican-Speaker Inversion Problem:</strong> Spanish speakers typically run this decision tree <em>in reverse</em> — defaulting to Past Simple and only switching to another tense when forced. Native English speakers run it forward — checking for Past Perfect, Present Perfect, and Past Continuous <em>first</em>, and falling back to Past Simple only when none of the first three apply. Reversing the order of these checks in your head is the single biggest fluency upgrade in this course.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: A Worked Example -->
  <section class="py-16 md:py-20 bg-white" id="section-3">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">A Worked Example</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">One real-world Mexican corporate story. All four tenses, used naturally, with the reasoning behind every choice.</p>

        <div class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 mb-6">
          <p class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-3">The Full Story</p>
          <div class="flex items-start gap-3">
            <p class="text-lg leading-relaxed text-slate-100 flex-1">
              "Last Tuesday morning, I <span class="bg-cyan-500/30 text-cyan-200 px-1.5 py-0.5 rounded">was preparing</span> the quarterly presentation when my CEO <span class="bg-emerald-500/30 text-emerald-200 px-1.5 py-0.5 rounded">called</span>. She <span class="bg-emerald-500/30 text-emerald-200 px-1.5 py-0.5 rounded">told</span> me she <span class="bg-amber-500/30 text-amber-200 px-1.5 py-0.5 rounded">had reviewed</span> the previous version the night before and <span class="bg-emerald-500/30 text-emerald-200 px-1.5 py-0.5 rounded">wasn't</span> happy with the numbers. By the time I <span class="bg-emerald-500/30 text-emerald-200 px-1.5 py-0.5 rounded">got off</span> the phone, the team <span class="bg-amber-500/30 text-amber-200 px-1.5 py-0.5 rounded">had already started</span> rebuilding the slides. I <span class="bg-violet-500/30 text-violet-200 px-1.5 py-0.5 rounded">have presented</span> the new version twice this week, and so far the feedback <span class="bg-violet-500/30 text-violet-200 px-1.5 py-0.5 rounded">has been</span> positive."
            </p>
            <AudioButton client:visible text="Last Tuesday morning, I was preparing the quarterly presentation when my CEO called. She told me she had reviewed the previous version the night before and wasn't happy with the numbers. By the time I got off the phone, the team had already started rebuilding the slides. I have presented the new version twice this week, and so far the feedback has been positive." lang="en-US" size="md" />
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-3 mb-6">
          <div class="flex items-center gap-2 text-sm"><span class="bg-cyan-500/30 text-cyan-700 px-1.5 py-0.5 rounded text-xs font-semibold">Past Continuous</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="bg-emerald-500/30 text-emerald-700 px-1.5 py-0.5 rounded text-xs font-semibold">Past Simple</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="bg-amber-500/30 text-amber-700 px-1.5 py-0.5 rounded text-xs font-semibold">Past Perfect</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="bg-violet-500/30 text-violet-700 px-1.5 py-0.5 rounded text-xs font-semibold">Present Perfect</span></div>
        </div>

        <h3 class="text-xl font-bold text-slate-900 mb-4">The reasoning, sentence by sentence</h3>
        <div class="space-y-3">
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
            <p class="text-sm text-slate-700"><strong class="text-slate-900">"I was preparing the presentation when my CEO called."</strong></p>
            <p class="text-sm text-slate-600 mt-1">Preparing was the background scene already in motion. The call cut into it. Classic Past Continuous + Past Simple interruption pattern (Lesson 2).</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
            <p class="text-sm text-slate-700"><strong class="text-slate-900">"She told me she had reviewed the previous version the night before."</strong></p>
            <p class="text-sm text-slate-600 mt-1">The telling happened in one past moment. The reviewing happened <em>before</em> that — the layer below. Past Perfect for the earlier event (Lesson 4).</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
            <p class="text-sm text-slate-700"><strong class="text-slate-900">"By the time I got off the phone, the team had already started rebuilding."</strong></p>
            <p class="text-sm text-slate-600 mt-1">"By the time" trigger again. The team's start happened before my hanging up. Past Perfect for the earlier; Past Simple for the anchor (Lesson 4).</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
            <p class="text-sm text-slate-700"><strong class="text-slate-900">"I have presented the new version twice this week."</strong></p>
            <p class="text-sm text-slate-600 mt-1">"This week" is still open. The presentations might continue. The thread runs from each presentation forward into the still-open week. Present Perfect (Lesson 3).</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
            <p class="text-sm text-slate-700"><strong class="text-slate-900">"...and so far the feedback has been positive."</strong></p>
            <p class="text-sm text-slate-600 mt-1">"So far" is the giveaway — the situation is ongoing. The feedback might shift. Present Perfect again (Lesson 3).</p>
          </div>
        </div>

        <div class="mt-6 bg-emerald-50 border border-emerald-200 rounded-xl p-5">
          <p class="text-sm text-emerald-900"><strong>What a Mexican speaker would typically default to:</strong> "Last Tuesday I prepared the presentation when my CEO called. She told me she reviewed it. I presented the new version twice this week." Same story — but flat, with the time relationships flattened. The native version above carries information that the flattened version simply <em>cannot</em>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Spanish-Speaker Synthesis Traps -->
  <section class="py-16 md:py-20 bg-slate-50" id="section-4">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Synthesis Traps</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Three high-level errors that show up when combining tenses, even after you've mastered each one individually. Tap the speaker on the correct version to hear the right form.</p>

        <div class="space-y-5">
          <!-- Trap 1: Past Simple cascade -->
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <h3 class="font-bold text-slate-900 mb-3">Trap 1 — The Past Simple cascade</h3>
            <div class="space-y-2">
              <p class="flex items-start gap-2"><XCircle class="w-5 h-5 text-red-500 shrink-0 mt-0.5" /><span class="text-slate-800"><em>"I went to the meeting. The CEO told me she reviewed the proposal. I sent the new version yesterday."</em></span></p>
              <div class="flex items-start gap-2">
                <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
                <span class="text-slate-800 flex-1"><em>"I <strong>went</strong> to the meeting. The CEO <strong>told</strong> me she <strong>had reviewed</strong> the proposal. I <strong>sent</strong> the new version yesterday."</em></span>
                <AudioButton client:visible text="I went to the meeting. The CEO told me she had reviewed the proposal. I sent the new version yesterday." lang="en-US" size="sm" />
              </div>
            </div>
            <p class="text-sm text-slate-600 mt-3">Putting every verb in Past Simple is the Mexican default. It flattens the timeline. The review happened <em>before</em> the telling — that needs Past Perfect. Forgetting it isn't grammatically wrong, but it loses information and signals "non-native" to the listener.</p>
          </div>

          <!-- Trap 2: Tense whiplash -->
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <h3 class="font-bold text-slate-900 mb-3">Trap 2 — Tense whiplash within a single story</h3>
            <div class="space-y-2">
              <p class="flex items-start gap-2"><XCircle class="w-5 h-5 text-red-500 shrink-0 mt-0.5" /><span class="text-slate-800"><em>"Yesterday I went to the office and I have seen my colleague. We discussed the project."</em></span></p>
              <div class="flex items-start gap-2">
                <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
                <span class="text-slate-800 flex-1"><em>"Yesterday I <strong>went</strong> to the office and <strong>saw</strong> my colleague. We <strong>discussed</strong> the project."</em></span>
                <AudioButton client:visible text="Yesterday I went to the office and saw my colleague. We discussed the project." lang="en-US" size="sm" />
              </div>
            </div>
            <p class="text-sm text-slate-600 mt-3">"Yesterday" closes the box. Every verb in the sentence has to live inside that closed box — Past Simple all the way through. Drifting into Present Perfect mid-story is the classic "by feel, not by picture" mistake. The mental discipline is to lock the time window first, then choose the tense to match.</p>
          </div>

          <!-- Trap 3: Skipping the layer marker -->
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <h3 class="font-bold text-slate-900 mb-3">Trap 3 — Skipping the layer marker when order matters</h3>
            <div class="space-y-2">
              <p class="flex items-start gap-2"><XCircle class="w-5 h-5 text-red-500 shrink-0 mt-0.5" /><span class="text-slate-800"><em>"When I called him, he already left the office. He was driving home."</em></span></p>
              <div class="flex items-start gap-2">
                <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
                <span class="text-slate-800 flex-1"><em>"When I called him, he <strong>had</strong> already <strong>left</strong> the office. He <strong>was driving</strong> home."</em></span>
                <AudioButton client:visible text="When I called him, he had already left the office. He was driving home." lang="en-US" size="sm" />
              </div>
            </div>
            <p class="text-sm text-slate-600 mt-3">The leaving happened before the call (Past Perfect). The driving was in progress when I called (Past Continuous). The call itself was the anchor moment (Past Simple). Three different tenses in two sentences — and they all carry meaning. Dropping any of them flattens the picture.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Mixed Check Yourself -->
  <section class="py-16 md:py-20 bg-white" id="section-5">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500 text-white text-sm font-bold">5</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Mixed Check Yourself</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Five scenes spanning all four tenses. Run the decision tree from Question 1 each time. The pattern is what builds the instinct.</p>

        <div class="space-y-4">
          <details class="bg-slate-50 rounded-xl border border-slate-200 group">
            <summary class="cursor-pointer p-5 list-none font-medium text-slate-900 flex items-center justify-between">
              <span><strong>1.</strong> <em>"I ___ (lived / have lived / was living) in Guadalajara since 2020."</em></span>
              <span class="text-emerald-600 text-sm group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-5 border-t border-slate-200 pt-4">
              <p class="text-slate-800"><strong>Answer: have lived.</strong> "Since 2020" + still living there = the thread runs to now. Present Perfect (Lesson 3).</p>
            </div>
          </details>

          <details class="bg-slate-50 rounded-xl border border-slate-200 group">
            <summary class="cursor-pointer p-5 list-none font-medium text-slate-900 flex items-center justify-between">
              <span><strong>2.</strong> <em>"By the time the meeting started, I ___ (forgot / had forgotten / have forgotten / was forgetting) my notes at home."</em></span>
              <span class="text-emerald-600 text-sm group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-5 border-t border-slate-200 pt-4">
              <p class="text-slate-800"><strong>Answer: had forgotten.</strong> "By the time" trigger. The forgetting happened before the meeting started. Past Perfect for the earlier event (Lesson 4).</p>
            </div>
          </details>

          <details class="bg-slate-50 rounded-xl border border-slate-200 group">
            <summary class="cursor-pointer p-5 list-none font-medium text-slate-900 flex items-center justify-between">
              <span><strong>3.</strong> <em>"I ___ (drove / was driving) home when I ___ (saw / had seen) the accident."</em></span>
              <span class="text-emerald-600 text-sm group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-5 border-t border-slate-200 pt-4">
              <p class="text-slate-800"><strong>Answer: was driving / saw.</strong> The driving was the background scene. The seeing was the interruption event. Classic Past Continuous + Past Simple (Lesson 2).</p>
            </div>
          </details>

          <details class="bg-slate-50 rounded-xl border border-slate-200 group">
            <summary class="cursor-pointer p-5 list-none font-medium text-slate-900 flex items-center justify-between">
              <span><strong>4.</strong> <em>Your boss asks "Have you eaten?" at 2pm. What's the natural reply: "No, I didn't" or "No, I haven't"?</em></span>
              <span class="text-emerald-600 text-sm group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-5 border-t border-slate-200 pt-4">
              <p class="text-slate-800"><strong>Answer: "No, I haven't."</strong> The question was in Present Perfect — the time window is still open (you might still eat). Mirror the tense in your reply. "No, I didn't" would sound like the lunch window has already closed (Lesson 3, the Mexican Professional Test).</p>
            </div>
          </details>

          <details class="bg-slate-50 rounded-xl border border-slate-200 group">
            <summary class="cursor-pointer p-5 list-none font-medium text-slate-900 flex items-center justify-between">
              <span><strong>5.</strong> <em>"She told me she ___ (worked / had worked / has worked) in Mexico City for five years before she ___ (moved / had moved) to Monterrey."</em></span>
              <span class="text-emerald-600 text-sm group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-5 border-t border-slate-200 pt-4">
              <p class="text-slate-800"><strong>Answer: had worked / moved.</strong> Two past events in a row, with order matters. The Mexico City years happened before the Monterrey move. Past Perfect for the earlier event (worked), Past Simple for the main moment (moved). (Lesson 4.)</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

