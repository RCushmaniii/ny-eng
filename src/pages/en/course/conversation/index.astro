---
export const prerender = true;

import Base from "@layouts/Base.astro";
import ConversationHub from "@components/course/conversation/ConversationHub.astro";
import ConversationSchema from "@components/course/conversation/ConversationSchema.astro";
import { conversationUi } from "@data/conversation/index";

const lang = "en";
const tkey = "course/conversation" as const;
const t = conversationUi[lang].hub;
---

<Base lang={lang} tkey={tkey} title={t.title} description={t.description}>
  <ConversationHub lang={lang} />
  <ConversationSchema lang={lang} />
</Base>
