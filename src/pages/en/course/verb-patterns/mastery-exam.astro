---
export const prerender = true;

import Base from "@layouts/Base.astro";
import CourseExam from "@components/course/CourseExam";
import {
  masteryExamQuestions,
  masteryExamTiers,
  masteryExamMeta,
} from "@data/verb-patterns/exam-mastery";
import { ArrowLeft, GraduationCap } from "lucide-astro";

const lang = "en";
const tkey = "course/verb-patterns/mastery-exam" as const;
---

<Base
  lang={lang}
  tkey={tkey}
  title="Mastery Exam — Verb Pattern Mastery | NY English Teacher"
  description="Final exam of Verb Pattern Mastery: 20 questions across meaning-changers, reporting verbs, and live diagnosis of every pattern. Free for Spanish speakers."
>
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <GraduationCap class="w-4 h-4" />
          Level 3 · Mastery — Final Exam
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Mastery Exam
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          The final test of the whole course. 20 questions mixing meaning-changers, reporting verbs,
          and live diagnosis of every pattern — with instant feedback on each answer. Pass this and the
          verb patterns are yours.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <CourseExam
        client:load
        questions={masteryExamQuestions}
        lang="en"
        passingScore={masteryExamMeta.passingScore}
        courseBasePath="/en/course/verb-patterns"
        tiers={masteryExamTiers}
        introSummary={masteryExamMeta.introSummary}
        completionMessage={masteryExamMeta.completionMessage}
        unitLabel="Lesson"
      />
    </div>
  </section>

  <section class="py-8 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4 text-center">
      <a href="/en/course/verb-patterns/" class="inline-flex items-center gap-2 text-slate-500 hover:text-indigo-600 transition-colors text-sm">
        <ArrowLeft class="w-4 h-4" /> Back to Course Overview
      </a>
    </div>
  </section>
</Base>
