---
export const prerender = true;

import Base from "@layouts/Base.astro";
import CourseLessonSchema from "@components/seo/CourseLessonSchema.astro";
import CourseExam from "@components/course/CourseExam";
import {
  patternsExamQuestions,
  patternsExamTiers,
  patternsExamMeta,
} from "@data/verb-patterns/exam-patterns";
import { ArrowLeft, GraduationCap } from "lucide-astro";

const lang = "en";
const tkey = "course/verb-patterns/patterns-exam" as const;
---

<Base
  lang={lang}
  tkey={tkey}
  title="Patterns Exam — Verb Pattern Mastery | NY English Teacher"
  description="Level 2 exam of Verb Pattern Mastery: 20 questions on preposition families, gerund vs infinitive, and causatives. Free for Spanish speakers, instant feedback."
>
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <GraduationCap class="w-4 h-4" />
          Level 2 · Patterns — Exam
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Patterns Exam
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Four lessons down: preposition families, to-do vs doing, the causatives, and the
          person-first patterns. 20 questions to lock them in — with instant feedback on every answer.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <CourseExam
        client:load
        questions={patternsExamQuestions}
        lang="en"
        passingScore={patternsExamMeta.passingScore}
        courseBasePath="/en/course/verb-patterns"
        tiers={patternsExamTiers}
        introSummary={patternsExamMeta.introSummary}
        completionMessage={patternsExamMeta.completionMessage}
        unitLabel="Lesson"
      />
    </div>
  </section>

  <section class="py-8 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4 text-center">
      <a href="/en/course/verb-patterns/" class="inline-flex items-center gap-2 text-slate-500 hover:text-indigo-600 transition-colors text-sm">
        <ArrowLeft class="w-4 h-4" /> Back to Course Overview
      </a>
    </div>
  </section>
  <CourseLessonSchema {lang} {tkey} />
</Base>
