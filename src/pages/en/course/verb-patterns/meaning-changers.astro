---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import PatternDrill from "@components/course/PatternDrill";
import ErrorCorrection from "@components/course/ErrorCorrection";
import { l8Drill, l8Corrections } from "@data/verb-patterns/lesson-8";
import { ArrowRight, Shuffle, CheckCircle2, XCircle } from "lucide-astro";

const lang = "en";
const tkey = "course/verb-patterns/meaning-changers" as const;

const bigFour = [
  {
    verb: "stop",
    toDo: "I stopped to check my phone.",
    toNote: "paused in order to",
    ing: "I stopped checking my phone.",
    ingNote: "quit the habit",
  },
  {
    verb: "remember",
    toDo: "Remember to send it.",
    toNote: "future task",
    ing: "I remember sending it.",
    ingNote: "past memory",
  },
  {
    verb: "try",
    toDo: "I tried to open the file.",
    toNote: "attempt, and failed",
    ing: "Try opening it in another app.",
    ingNote: "experiment with a fix",
  },
  {
    verb: "regret",
    toDo: "We regret to inform you…",
    toNote: "formal bad news, now",
    ing: "I regret telling him.",
    ingNote: "sorry about the past",
  },
];

const twoMore = [
  {
    verb: "forget",
    toDo: "I forgot to lock the door.",
    toNote: "failed the task",
    ing: "I'll never forget meeting her.",
    ingNote: "memorable past",
  },
  {
    verb: "go on",
    toDo: "After sales, she went on to discuss hiring.",
    toNote: "new topic",
    ing: "She went on talking for an hour.",
    ingNote: "continued same action",
  },
];
---

<Base
  lang={lang}
  tkey={tkey}
  title="When the Pattern Changes the Meaning: stop, remember, try, regret | Verb Patterns Lesson 8"
  description="Lesson 8 of Verb Pattern Mastery. stop to do vs stop doing, remember/forget/try/regret — the verbs where the form changes the meaning, not just grammar."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <Shuffle class="w-4 h-4" />
          Level 3 · Mastery — Lesson 8
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          When the Pattern Changes the Meaning
        </h1>
        <p class="text-2xl text-indigo-300 italic font-light mb-4">Same verb, two forms, two meanings.</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          With these verbs, both <em class="text-white not-italic">to&nbsp;do</em> and
          <em class="text-white not-italic">-ing</em> are grammatical — but they mean
          <strong class="text-white">different things</strong>. Choosing the wrong one isn't a slip;
          it says something else entirely.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 1: the big four -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The big four</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Read both sides. Same verb — the form flips the meaning.</p>
        <div class="space-y-4">
          {bigFour.map((v) => (
            <div class="rounded-2xl border border-slate-200 overflow-hidden">
              <div class="bg-slate-50 px-5 py-2 border-b border-slate-200">
                <p class="text-sm font-mono font-semibold text-indigo-700">{v.verb}</p>
              </div>
              <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">to&nbsp;do — {v.toNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.toDo}</p>
                    <AudioButton client:visible text={v.toDo} lang="en-US" size="sm" />
                  </div>
                </div>
                <div class="p-5 bg-indigo-50/40">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">-ing — {v.ingNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.ing}</p>
                    <AudioButton client:visible text={v.ing} lang="en-US" size="sm" />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: two more -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Two more</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11"><em>forget</em> and <em>go on</em> follow the same logic.</p>
        <div class="space-y-4">
          {twoMore.map((v) => (
            <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
              <div class="bg-slate-50 px-5 py-2 border-b border-slate-200">
                <p class="text-sm font-mono font-semibold text-indigo-700">{v.verb}</p>
              </div>
              <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">to&nbsp;do — {v.toNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.toDo}</p>
                    <AudioButton client:visible text={v.toDo} lang="en-US" size="sm" />
                  </div>
                </div>
                <div class="p-5 bg-indigo-50/40">
                  <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2">-ing — {v.ingNote}</p>
                  <div class="flex items-center gap-2">
                    <p class="text-slate-900 flex-1">{v.ing}</p>
                    <AudioButton client:visible text={v.ing} lang="en-US" size="sm" />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: PatternDrill -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Drill: which meaning?</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Both forms are grammatical. Read the meaning, then choose.</p>
        <PatternDrill client:visible data={l8Drill} lang="en" />
      </div>
    </div>
  </section>

  <!-- Section 4: ErrorCorrection -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Spot the error</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Here the wrong form gives the wrong meaning. Tap the part that doesn't fit.</p>
        <ErrorCorrection client:visible data={l8Corrections} lang="en" />
      </div>
    </div>
  </section>

  <!-- Recap + next -->
  <section class="py-16 md:py-20 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6 text-center">The Recap</h2>
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-8 mb-10">
          <ul class="space-y-3 text-slate-700">
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>to&nbsp;do</strong> looks forward — a purpose, a future task, an attempt, or a fixed formal phrase.</span></li>
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>-ing</strong> looks back or inward — a habit, a memory, or an experiment you're testing.</span></li>
            <li class="flex gap-3"><XCircle class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" /><span>Both are grammatical, so a spell-check won't save you — <strong>meaning</strong> is your only guide.</span></li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-slate-600 mb-6">Next up: <strong class="text-slate-900">Reporting Verbs</strong> — how to say what someone else said without quoting them word for word.</p>
          <Button href="/en/course/verb-patterns/reporting-verbs/" variant="primary" size="lg">
            Lesson 9: Reporting Verbs
            <ArrowRight class="w-5 h-5 ml-1" />
          </Button>
          <div class="mt-6">
            <a href="/en/course/verb-patterns/" class="text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2">← Back to course overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
