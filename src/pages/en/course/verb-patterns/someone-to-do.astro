---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import AudioButton from "@components/course/AudioButton";
import PatternDrill from "@components/course/PatternDrill";
import ErrorCorrection from "@components/course/ErrorCorrection";
import { l6Drill, l6Corrections } from "@data/verb-patterns/lesson-6";
import { ArrowRight, Users, CheckCircle2, XCircle, AlertTriangle } from "lucide-astro";

const lang = "en";
const tkey = "course/verb-patterns/someone-to-do" as const;

const toDoVerbs = [
  "want", "need", "expect", "ask", "tell", "allow", "advise",
  "invite", "encourage", "warn", "persuade", "require", "teach", "remind",
];
---

<Base
  lang={lang}
  tkey={tkey}
  title="Want Someone To Do · Make, Let & Help | Verb Patterns Lesson 6"
  description="Lesson 6 of Verb Pattern Mastery. want/need/allow someone to do — but make and let take the base verb with no 'to'. Stop saying 'made me to repeat'."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <Users class="w-4 h-4" />
          Level 2 · Patterns — Lesson 6
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight" style="font-family: 'Noto Sans KR', sans-serif;">
          Someone To Do · Make, Let &amp; Help
        </h1>
        <p class="text-2xl text-indigo-300 italic font-light mb-4">Most verbs need “to”. Make and let don't.</p>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          When you want another person to do something, almost every verb follows the same shape:
          <em class="text-white not-italic">verb + someone + to&nbsp;do</em>. But two everyday verbs —
          <em class="text-white not-italic">make</em> and <em class="text-white not-italic">let</em> — drop the
          “to” completely. Get this pair right and you'll stop saying <span class="line-through">made me to repeat</span>.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 1: the default -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">1</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The default: someone + to do</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Most verbs keep the “to”.</p>
        <div class="space-y-4 text-lg text-slate-700 leading-relaxed">
          <p>
            The safe, default pattern is <em>verb + someone + to&nbsp;do something</em>. Nearly every verb of
            wanting, asking, or allowing follows it:
          </p>
          <div class="flex flex-wrap gap-2 my-4">
            {toDoVerbs.map((v) => (
              <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-3 py-1 text-sm font-mono text-indigo-700">{v}</span>
            ))}
          </div>
          <div class="grid sm:grid-cols-2 gap-4 my-4">
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">need + someone + to do</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">I need you to send the file.</p>
                <AudioButton client:visible text="I need you to send the file." lang="en-US" size="sm" />
              </div>
            </div>
            <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">persuade + someone + to do</p>
              <div class="flex items-center gap-2">
                <p class="text-slate-900 flex-1">They persuaded us to accept the offer.</p>
                <AudioButton client:visible text="They persuaded us to accept the offer." lang="en-US" size="sm" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: the exceptions make & let -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-500 text-white text-sm font-bold">2</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The exceptions: make &amp; let (no “to”)</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Two verbs take the base verb — never “to”.</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-xl border-2 border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-700 mb-1">make + someone + base verb</p>
            <div class="flex items-center gap-2">
              <p class="text-slate-900 flex-1">My boss made me rewrite the email.</p>
              <AudioButton client:visible text="My boss made me rewrite the email." lang="en-US" size="sm" />
            </div>
          </div>
          <div class="rounded-xl border-2 border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-700 mb-1">let + someone + base verb</p>
            <div class="flex items-center gap-2">
              <p class="text-slate-900 flex-1">She let her son use the car.</p>
              <AudioButton client:visible text="She let her son use the car." lang="en-US" size="sm" />
            </div>
          </div>
        </div>
        <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
          <strong>Meaning:</strong> <em>make</em> = force / oblige · <em>let</em> = give permission.
          Never <span class="line-through">made me to</span> or <span class="line-through">let him to</span>.
        </div>
        <div class="mt-4 bg-white border border-slate-200 rounded-xl p-4 text-sm text-slate-700">
          <strong>One flexible verb:</strong> with <em>help</em>, both are fine —
          “This app helps me save time” or “helps me to save time.” The base verb is the more natural choice.
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: I need to vs I need you to -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">3</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">I need to vs I need you to</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Adding the person moves the responsibility.</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">no person → I must</p>
            <div class="flex items-center gap-2">
              <p class="text-slate-900 flex-1">I need to send the report.</p>
              <AudioButton client:visible text="I need to send the report." lang="en-US" size="sm" />
            </div>
            <p class="text-sm text-slate-500 mt-2">The responsibility is mine.</p>
          </div>
          <div class="rounded-xl border-2 border-indigo-200 bg-indigo-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-700 mb-1">+ person → you must</p>
            <div class="flex items-center gap-2">
              <p class="text-slate-900 flex-1">I need you to send the report.</p>
              <AudioButton client:visible text="I need you to send the report." lang="en-US" size="sm" />
            </div>
            <p class="text-sm text-slate-500 mt-2">Now the responsibility is yours.</p>
          </div>
        </div>
        <div class="mt-4 text-lg text-slate-700 leading-relaxed">
          <p>Adding the person after the verb shifts the responsibility from you to them — a small change with a big difference in meaning.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: PatternDrill -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">4</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Drill: to do, or base verb?</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">After the person: “to do”, or the base verb with no “to”?</p>
        <PatternDrill client:visible data={l6Drill} lang="en" />
      </div>
    </div>
  </section>

  <!-- Section 5: ErrorCorrection -->
  <section class="py-16 md:py-20 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white text-sm font-bold">5</span>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Spot the error</h2>
        </div>
        <p class="text-slate-500 mb-8 ml-11">Tap the wrong part of each sentence.</p>
        <ErrorCorrection client:visible data={l6Corrections} lang="en" />
      </div>
    </div>
  </section>

  <!-- Recap + next -->
  <section class="py-16 md:py-20 bg-slate-50 border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6 text-center">The Recap</h2>
        <div class="bg-white rounded-2xl border border-slate-200 p-8 mb-10">
          <ul class="space-y-3 text-slate-700">
            <li class="flex gap-3"><CheckCircle2 class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>The default is “to”</strong> — want, need, ask, allow, persuade + someone + <em>to&nbsp;do</em>.</span></li>
            <li class="flex gap-3"><AlertTriangle class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" /><span><strong>make and let take the base verb</strong> — no “to”. Never <span class="line-through">made me to</span> / <span class="line-through">let him to</span>.</span></li>
            <li class="flex gap-3"><XCircle class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" /><span><strong>Adding the person shifts responsibility</strong> — <em>I need to</em> (me) vs <em>I need you to</em> (you).</span></li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-slate-600 mb-6">Next up: <strong class="text-slate-900">Someone + Preposition</strong> — the verbs that need a preposition before the person, and the ones that don't.</p>
          <Button href="/en/course/verb-patterns/someone-preposition/" variant="primary" size="lg">
            Lesson 7: Someone + Preposition
            <ArrowRight class="w-5 h-5 ml-1" />
          </Button>
          <div class="mt-6">
            <a href="/en/course/verb-patterns/" class="text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2">← Back to course overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
