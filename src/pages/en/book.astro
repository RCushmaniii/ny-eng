---
export const prerender = true;

import Base from "@layouts/Base.astro";
import BookingPageLayout from "@components/booking/BookingPageLayout.astro";

const metadata = {
  title: "Book Your Free Strategy Session",
  description:
    "Schedule a free 30-minute strategy session. Find out exactly where your English is costing you opportunities — and how to fix it.",
};

const heroContent = {
  title: "Book Your Free Strategy Session",
  description:
    "In 30 minutes, I'll pinpoint exactly where your English is costing you opportunities — and map a clear path to fix it. No sales scripts. No obligation.",
};
---

<Base
  lang="en"
  tkey="book"
  title={metadata.title}
  description={metadata.description}
  ogImage={{ src: "/images/logos/new-york-english-sq-og.jpg" }}
>
  <BookingPageLayout lang="en" title={heroContent.title} description={heroContent.description}>
    <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
      Need to cancel or reschedule? Please give at least 24 hours' notice.
      See our <a
        href="/en/legal/cancellation-policy/"
        class="underline hover:text-gray-700 dark:hover:text-gray-200">Cancellation Policy</a
      >.
    </p>
  </BookingPageLayout>
</Base>
