---
export const prerender = true;

import Base from "@layouts/Base.astro";
import Button from "@components/ui/Button.astro";
import { courseInfo, units } from "@data/course/units";
import { elementaryInfo, elementaryUnits } from "@data/elementary/units";
import { intermediateInfo, intermediateUnits } from "@data/intermediate/units";
import { advancedInfo, advancedUnits } from "@data/advanced/units";
import { executiveInfo, executiveUnits } from "@data/executive/units";
import { driveInfo, scenarioMeta } from "@data/drive-the-decision/scenarios";
import { pushbackInfo, pushbackLessons } from "@data/executive-pushback/lessons";
import TestimonialCard from "@components/ui/TestimonialCard.astro";
import { testimonials } from "@data/testimonials/en";
import {
  Sparkles,
  BookOpen,
  Puzzle,
  Crown,
  ArrowRight,
  CheckCircle2,
  GraduationCap,
  Target,
  Zap,
  Search,
} from "lucide-astro";

const lang = "en";
const tkey = "courses" as const;

const beginnerAvailable = units.length;
const elementaryAvailable = elementaryUnits.filter((u) => u.published).length;
const elementaryTotal = elementaryUnits.length;
const intermediateAvailable = intermediateUnits.length;
const advancedAvailable = advancedUnits.length;
const executiveAvailable = executiveUnits.filter((u) => u.published).length;
const driveScenariosAvailable = scenarioMeta.filter((s) => s.available).length;
const pushbackLessonsAvailable = pushbackLessons.filter((l) => l.available).length;

// Hero quick-start level selector — fast path into each leveled track
const levelSelector = [
  { label: "A1 · Beginner", sub: "English still feels brand new", href: "/en/course/beginners/" },
  { label: "A2 · Elementary", sub: "Talk about yesterday and your plans", href: "/en/course/elementary/" },
  { label: "B1–B2 · Intermediate", sub: "Stop translating in your head", href: "/en/course/intermediate/" },
  { label: "B2–C1 · Advanced", sub: "Fluent — now get polished", href: "/en/course/advanced/" },
  { label: "C1–C2 · Executive", sub: "Lead the room in English", href: "/en/course/executive/" },
];

// Real client proof, pulled from the coaching testimonials (no invented numbers)
const featuredAuthors = ["Julio Aldana", "Hugo Blum", "Andres Guzman Rubio"];
const featuredTestimonials = featuredAuthors
  .map((name) => testimonials.find((t) => t.author === name))
  .filter((t): t is (typeof testimonials)[number] => Boolean(t));

// FAQ — targets high-volume beginner / free-course search queries
const faqs = [
  {
    q: "Are these English courses really free?",
    a: "Yes. Every course — from A1 beginner to C2 executive — is completely free. No sign-up, no credit card, no paywall, and no trial that expires. You can start any lesson right now.",
  },
  {
    q: "How can a Spanish speaker learn English from scratch?",
    a: "Start with the beginner (A1) course. Instead of memorizing lists, it begins with the 1,500+ English words already hiding in your Spanish (cognates), then builds real sentences from the first lesson. By Unit 10 you can hold a basic conversation.",
  },
  {
    q: "Which free English course should a beginner start with?",
    a: "If English feels brand new, start with the A1 Beginner course. If you know the basics but can't yet talk about the past or make plans, take A2 Elementary. If you can already hold a conversation, jump to B1–B2 Intermediate.",
  },
  {
    q: "Can I really learn English online for free with no app to install?",
    a: "Yes. Everything runs in your browser — nothing to download. Each lesson is interactive, with audio for every word and phrase and a self-test to lock it in. Your progress is saved automatically on your device.",
  },
  {
    q: "How long does it take to learn English with these courses?",
    a: "It depends on how often you practice, but each leveled track is 10 short units plus a final exam. Practicing a few times a week, most learners move through a level in a couple of months — and you feel real progress from the first lesson.",
  },
  {
    q: "Who makes these courses?",
    a: "They're built by Robert Cushman, a New York English teacher who coaches executives and professionals one-on-one. The same methods behind his private coaching shape every free course here.",
  },
  // Absorbed from the retired /en/blog/free-english-courses-spanish-speakers/ post
  // when it was consolidated into this hub (2026-07-25). Both pages targeted the
  // same query cluster and split the ranking signal between them.
  {
    q: "What kind of voice is used for the audio — is it a real person?",
    a: "Every example phrase uses clear, natural American English audio, recorded at conversational speed rather than the slowed-down delivery most learning apps use. That matters: if you only ever practice against slow audio, real meetings still sound fast. You hear the rhythm, stress, and linking exactly as a native speaker would say it.",
  },
  {
    q: "Can I take more than one course at the same time?",
    a: "Yes, and for many people it works better. A common pairing is one leveled course for structure — Beginner through Executive — plus one focused master class like Verb Pattern Mastery or Past Tenses for a specific weak spot. Nothing is locked, there's no set order, and no progress is lost by moving between them.",
  },
];

// Provider + free offer reused across every Course entry
const courseProvider = {
  "@type": "Organization",
  "@id": "https://www.nyenglishteacher.com/#org",
  name: "New York English Teacher",
  url: "https://www.nyenglishteacher.com/",
};
const freeOffer = {
  "@type": "Offer",
  category: "Free",
  price: "0",
  priceCurrency: "USD",
  availability: "https://schema.org/InStock",
};

const courseList = [
  {
    name: "Free English Course (Beginner, A1)",
    url: "https://www.nyenglishteacher.com/en/course/beginners/",
    description:
      "A free interactive A1 course for Spanish speakers. Start from the 1,500+ English words hiding in your Spanish and reach a real conversation by Unit 10.",
    workload: "PT10H",
  },
  {
    name: "Free Elementary English Course (A2)",
    url: "https://www.nyenglishteacher.com/en/course/elementary/",
    description:
      "The free A2 bridge from beginner to intermediate: past tense, future plans, comparatives, and the questions that turn yes/no answers into real conversation.",
    workload: "PT10H",
  },
  {
    name: "Free Intermediate English Course (B1–B2)",
    url: "https://www.nyenglishteacher.com/en/course/intermediate/",
    description:
      "A free B1–B2 course that rewires the translate-in-your-head habit. Phrasal verbs, conditionals, and the natural patterns natives actually use.",
    workload: "PT12H",
  },
  {
    name: "Free Advanced English Course (B2–C1)",
    url: "https://www.nyenglishteacher.com/en/course/advanced/",
    description:
      "A free B2–C1 course of targeted drills that fix the exact errors haunting advanced Spanish speakers — articles, word traps, and pronunciation tells.",
    workload: "PT12H",
  },
  {
    name: "Executive English Course (C1–C2)",
    url: "https://www.nyenglishteacher.com/en/course/executive/",
    description:
      "The free, productized version of Robert's 1-on-1 executive coaching: speaking-first drills, named frameworks, and precision language that signals command.",
    workload: "PT15H",
  },
  {
    name: "Master English Past Tenses (Free Master Class)",
    url: "https://www.nyenglishteacher.com/en/course/past-tenses/",
    description:
      "A free targeted master class that rewires past-tense choice through visualization, not memorization. Six lessons plus a cheat sheet and 30-day plan.",
    workload: "PT4H",
  },
  {
    name: "Drive the Decision — Executive Boardroom Simulation (Free Master Class)",
    url: "https://www.nyenglishteacher.com/en/course/drive-the-decision/",
    description:
      "A free executive master class: ten worked boardroom scenarios with model replies and the decision psychology behind them, plus a 12-item reflex drill.",
    workload: "PT5H",
  },
  {
    name: "Executive Pushback & Objection Handling (Free Master Class)",
    url: "https://www.nyenglishteacher.com/en/course/executive-pushback/",
    description:
      "A free master class in reading the real driver under an objection and responding with structure instead of defensiveness: Acknowledge, Clarify, Redirect.",
    workload: "PT4H",
  },
  {
    name: "English Verb Pattern Mastery (Free Master Class)",
    url: "https://www.nyenglishteacher.com/en/course/verb-patterns/",
    description:
      "A free master class on English verb patterns for Spanish speakers — object patterns, verb + preposition, gerund vs infinitive, causatives, and reporting verbs. Learn every verb together with its structure.",
    workload: "PT6H",
  },
];

const courseItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Free English Courses for Spanish Speakers",
  description:
    "Free, interactive English courses for Spanish speakers — A1 beginner through C2 executive. No sign-up, no paywall.",
  url: "https://www.nyenglishteacher.com/en/courses/",
  itemListElement: courseList.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Course",
      name: c.name,
      description: c.description,
      url: c.url,
      inLanguage: "en",
      isAccessibleForFree: true,
      provider: courseProvider,
      offers: freeOffer,
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: "online",
        courseWorkload: c.workload,
      },
    },
  })),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  lang={lang}
  tkey={tkey}
  title="Free English Courses for Spanish Speakers | NY English"
  description="Free, interactive English courses for Spanish speakers — A1 beginner through C2 executive. No sign-up, no paywall. Built by a real NYC English teacher."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-slate-800 pt-24 pb-20 md:pt-32 md:pb-24">
    <div class="site-container mx-auto px-4 text-white">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
       <div class="max-w-2xl">
        <div class="flex items-center gap-2 text-amber-400 text-sm font-semibold mb-3">
          <GraduationCap class="w-4 h-4" />
          Free Courses
        </div>
        <h1
          class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight"
          style="font-family: 'Noto Sans KR', sans-serif;"
        >
          English Courses That Actually Work for Spanish Speakers
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
          Nine free, interactive courses built for Spanish speakers — five
          leveled tracks from A1 beginner through C2 executive, plus four
          focused master classes: verb patterns, past tenses, executive
          decision communication, and executive pushback handling. No sign-up.
          No paywall. No textbook drudgery. Just real progress from the first
          lesson.
        </p>
       </div>
       <div class="w-full">
         <div class="rounded-2xl bg-white/5 border border-white/10 p-5 sm:p-6 backdrop-blur-sm">
           <p class="text-amber-300 text-sm font-semibold mb-1">Start where you are</p>
           <p class="text-slate-400 text-sm mb-4">Pick your level and jump straight in — no sign-up.</p>
           <div class="flex flex-col gap-2">
             {levelSelector.map((lvl) => (
               <a
                 href={lvl.href}
                 class="group/lvl flex items-center justify-between gap-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-300/50 px-4 py-3 transition-all"
               >
                 <span class="min-w-0">
                   <span class="block text-white font-semibold text-sm">{lvl.label}</span>
                   <span class="block text-slate-400 text-xs">{lvl.sub}</span>
                 </span>
                 <ArrowRight class="w-4 h-4 text-amber-300 shrink-0 transition-transform group-hover/lvl:translate-x-0.5" />
               </a>
             ))}
           </div>
         </div>
       </div>
      </div>
    </div>
  </section>

  <!-- Course cards -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="site-container mx-auto px-4">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Beginner -->
        <a
          href="/en/course/beginners/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-amber-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-emerald-100 text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles class="w-3.5 h-3.5" />
              Level A1 — Beginner
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {courseInfo.title}
            </h2>
            <p class="text-emerald-50 text-sm leading-relaxed">
              {courseInfo.tagline}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              Most courses make Spanish speakers start from zero. We don't.
              You already know 1,500+ English words — they're hiding in your
              Spanish. By Unit 10, you're holding a real conversation.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>10 interactive units + final exam</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>1,500+ English/Spanish cognates</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                <span>Audio for every word and phrase</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">
                {beginnerAvailable} units available
              </span>
              <span class="inline-flex items-center gap-1 text-amber-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Start course
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Elementary -->
        <a
          href="/en/course/elementary/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-sky-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-sky-500 to-sky-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-sky-100 text-xs font-bold uppercase tracking-wider mb-2">
              <BookOpen class="w-3.5 h-3.5" />
              Level A2 — Elementary
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {elementaryInfo.title}
            </h2>
            <p class="text-sky-50 text-sm leading-relaxed">
              From fragments to full stories — past, present, and future of your real life.
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              The bridge from beginner to intermediate. Past tense, future plans,
              comparing things, and the questions that turn "yes/no" answers into
              real conversation. By Unit 10, you tell your own story.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                <span>Past simple — regular and irregular verbs</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                <span>Going to + will, comparatives, quantifiers</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                <span>Capstone: a 60-second story about your life</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">
                {elementaryAvailable > 0
                  ? `${elementaryAvailable} of ${elementaryTotal} units available`
                  : "Coming soon · building now"}
              </span>
              <span class="inline-flex items-center gap-1 text-sky-600 font-semibold text-sm group-hover:gap-2 transition-all">
                {elementaryAvailable > 0 ? "Start course" : "Preview"}
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Intermediate -->
        <a
          href="/en/course/intermediate/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-amber-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-amber-500 to-amber-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-amber-100 text-xs font-bold uppercase tracking-wider mb-2">
              <Puzzle class="w-3.5 h-3.5" />
              Level B1–B2 — Intermediate
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {intermediateInfo.title}
            </h2>
            <p class="text-amber-50 text-sm leading-relaxed">
              {intermediateInfo.tagline}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              You can hold a conversation — but every sentence still goes
              through Spanish first. This course rewires that. Phrasal verbs,
              conditionals, and the natural patterns natives actually use,
              drilled until English comes out without translating.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Modals, conditionals & sentence construction</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Office, travel, and social English</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Fixes the exact mistakes Spanish speakers make</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-amber-600 uppercase tracking-wider">
                {intermediateAvailable} units available
              </span>
              <span class="inline-flex items-center gap-1 text-amber-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Start course
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Advanced -->
        <a
          href="/en/course/advanced/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-violet-300 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-violet-500 to-violet-600 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-violet-100 text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles class="w-3.5 h-3.5" />
              Level B2–C1 — Advanced
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {advancedInfo.title}
            </h2>
            <p class="text-violet-50 text-sm leading-relaxed">
              {advancedInfo.tagline}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              Your English is fluent. It's not polished. Even at C1, the wrong
              article, the missed "fewer", and the soft TH give you away in
              the first thirty seconds. Drills that fix the exact errors
              haunting advanced Spanish speakers — no themes, no memorization.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-violet-500 shrink-0 mt-0.5" />
                <span>Strong phrasing & precision vocabulary</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-violet-500 shrink-0 mt-0.5" />
                <span>Articles, pronouns, word traps — the lifelong errors</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-violet-500 shrink-0 mt-0.5" />
                <span>Pronunciation tells that give you away</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-violet-600 uppercase tracking-wider">
                {advancedAvailable} units available
              </span>
              <span class="inline-flex items-center gap-1 text-violet-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Start course
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Executive -->
        <a
          href="/en/course/executive/"
          class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-amber-400 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-amber-900 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-amber-300 text-xs font-bold uppercase tracking-wider mb-2">
              <Crown class="w-3.5 h-3.5" />
              Level C1–C2 — Executive
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
              {executiveInfo.title}
            </h2>
            <p class="text-amber-100 text-sm leading-relaxed">
              {executiveInfo.tagline}
            </p>
          </div>
          <div class="p-6">
            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              When the room expects a leader, fluent isn't enough. The
              productized version of Robert's 1-on-1 executive coaching —
              speaking-first drills, named frameworks, and the precision
              language that signals command under pressure.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Word precision, structured responses & named frameworks</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>C1 core with optional C2 Elite tier per drill</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <CheckCircle2 class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Capstone: recorded exec presentation + personal feedback</span>
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-amber-600 uppercase tracking-wider">
                {executiveAvailable} units available
              </span>
              <span class="inline-flex items-center gap-1 text-amber-600 font-semibold text-sm group-hover:gap-2 transition-all">
                Start course
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </a>

        <!-- Master Class — Past Tenses -->
        <a
          href="/en/course/past-tenses/"
          class="group block bg-white rounded-2xl border-2 border-emerald-500/30 overflow-hidden hover:shadow-xl hover:border-emerald-400 transition-all duration-200"
        >
          <div class="bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 p-6 text-white min-h-[180px] flex flex-col justify-end">
            <div class="flex items-center gap-2 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-2">
              <Target class="w-3.5 h-3.5" />
              Master Class — B1 to C1
            </div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: 'Noto Sans KR', sans-serif;">
