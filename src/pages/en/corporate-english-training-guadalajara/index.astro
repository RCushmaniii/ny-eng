---
export const prerender = true;

/**
 * Category page — "corporate English training Guadalajara".
 *
 * English twin of /es/ingles-para-empresas-guadalajara/. The Spanish side is
 * the commercially important one, because the buyer searches in Spanish; this
 * exists so the pair is complete for hreflang and so a multinational HR lead
 * operating in English lands somewhere sensible.
 *
 * Same cannibalisation rule as the Spanish page: this is the ONLY corporate
 * page targeting the broad category. /en/services/corporate-package/ targets
 * the 12-week program, /en/for-hr-managers/ targets the HR evaluator.
 */

import Base from "@layouts/Base.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import LeadMagnetForm from "@components/sections/LeadMagnetForm.astro";
import BreadcrumbSchema from "@components/seo/BreadcrumbSchema.astro";
import { testimonials as enTestimonials } from "@data/testimonials/en";

const title = "Corporate English Training in Guadalajara | For Teams";
const seoDescription =
  "Corporate English training in Guadalajara and Zapopan. For managers, directors and teams who work in English with clients, suppliers and US head offices.";

/** Filtered against published testimonials — see the Spanish twin. */
const FEATURED_CLIENTS = [
  "Driscoll's",
  "Continental",
  "Sanmina Corporation",
  "CEVA Logistics",
  "Terramar Brands",
  "Grupo Kopar",
  "Smarttie",
  "100 Ladrillos",
];
const publishedCompanies = new Set(enTestimonials.map((t) => t.company).filter(Boolean));
const corporateClients = FEATURED_CLIENTS.filter((c) => publishedCompanies.has(c));

const ctaContent = {
  eyebrow: "Corporate Programs",
  title: "Want your team working comfortably in English?",
  description:
    "We start with a short call to understand group size, schedules, and what each person actually needs in their role. I reply within 24 hours.",
  buttonSubtext: "The call takes about 20 minutes.",
  buttonText: "Schedule a call",
  buttonLink: "/en/book/",
  secondaryButtonText: "Message me on WhatsApp",
  secondaryButtonLink: "https://wa.me/523315590572",
  whatToExpectTitle: "On the call we will:",
  whatToExpectList: [
    "Establish your team's real English communication baseline",
    "Scope the format for group size, schedule, and your industry",
    "Agree how progress gets measured",
  ],
};
---

<Base
  title={title}
  description={seoDescription}
  lang="en"
  tkey="corporate/english-for-companies"
  hideCta={true}
>
  <BreadcrumbSchema
    items={[
      { name: "Home", url: "/en/" },
      {
        name: "Corporate English training in Guadalajara",
        url: "/en/corporate-english-training-guadalajara/",
      },
    ]}
  />

  <!-- Hero -->
  <section class="bg-secondary text-white py-20 px-8">
    <div class="site-container--small mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide mb-4 opacity-80">
        Corporate English training
      </p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        English Training for Companies in Guadalajara
      </h1>
      <p class="text-lg opacity-90">
        Customized training for managers, directors and teams who need to work in English with
        clients, suppliers and international leadership. Online or at your offices, across
        Guadalajara and Zapopan.
      </p>
    </div>
  </section>

  <!-- Roster -->
  {corporateClients.length > 0 && (
    <section class="bg-white pt-12 pb-6 px-8">
      <div class="site-container--small mx-auto">
        <p class="text-center text-sm text-gray-500 mb-6">
          Leaders at these companies have worked with me one to one
        </p>
        <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3">
          {corporateClients.map((name) => (
            <li class="text-gray-700 font-semibold tracking-tight">{name}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Who it is for -->
  <section class="bg-light py-16 px-8">
    <div class="site-container--small mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold mb-4 text-center">Who this is for</h2>
      <p class="text-center text-gray-600 mb-10">
        This is not a general English course. It is training for people who already hold the role
        and need to sound as capable in English as they do in Spanish.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <h3 class="font-bold mb-2">Leadership teams</h3>
          <p class="text-gray-600 text-sm">
            Managers and directors who present results, negotiate, and report to a US parent company
            or head office.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <h3 class="font-bold mb-2">Cross-border functions</h3>
          <p class="text-gray-600 text-sm">
            Sales, procurement, logistics, engineering and operations — where one meeting in English
            turns into revenue or into a delay.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <h3 class="font-bold mb-2">Companies expanding north</h3>
          <p class="text-gray-600 text-sm">
            Mexican companies that just opened a US market and suddenly need English to stop being
            the bottleneck.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Two ways to work -->
  <section class="bg-white py-16 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold mb-4 text-center">Two ways to work together</h2>
      <p class="text-center text-gray-600 mb-10">
        One structured, with formal reporting for HR. One with no fixed calendar, for teams that
        just want to move.
      </p>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="border border-gray-200 rounded-xl p-8">
          <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">
            Structured program
          </p>
          <h3 class="text-xl font-bold mb-3">12-week program for leadership teams</h3>
          <p class="text-gray-600 text-sm mb-4">
            Baseline assessment, individual preparation, a group presentation in front of their own
            colleagues, and a final assessment against the baseline. Includes an initial profile,
            monthly evaluations, a written roadmap per participant, and a consolidated company
            report.
          </p>
          <a
            href="/en/services/corporate-package/"
            class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:underline"
          >
            See the full program <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="border border-gray-200 rounded-xl p-8">
          <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">
            Ongoing coaching
          </p>
          <h3 class="text-xl font-bold mb-3">Flexible training, no formal structure</h3>
          <p class="text-gray-600 text-sm mb-4">
            For teams that do not need the reporting layer. Ongoing sessions focused on meetings,
            presentations, negotiation and everyday professional communication, with no fixed
            timeline and no HR documentation.
          </p>
          <a
            href="/en/services/ongoing-coaching/"
            class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:underline"
          >
            See ongoing coaching <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How companies evaluate -->
  <section class="bg-light py-16 px-8">
    <div class="site-container--small mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold mb-8 text-center">How companies evaluate this</h2>
      <div class="space-y-5">
        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold mb-1">A demo class, and you sit in on it</h3>
          <p class="text-gray-600 text-sm">
            Before any commitment, one of your people takes a real session and you watch it. Not a
            sales call — an actual session on that person's actual work.
          </p>
        </div>
        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold mb-1">Invoicing your finance team can process</h3>
          <p class="text-gray-600 text-sm">
            I invoice under a Mexican RFC and issue facturas monthly against sessions delivered. USD
            invoicing is available for companies billing outside Mexico.
          </p>
        </div>
        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold mb-1">The price does not change with headcount</h3>
          <p class="text-gray-600 text-sm">
            Every session is built for one person's role, so five participants is five separate
            preparations rather than one lesson delivered five times.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Local -->
  <section class="bg-white py-16 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold mb-4 text-center">Guadalajara, Zapopan, and online</h2>
      <p class="text-gray-600 text-center">
        I live in Guadalajara. Sessions run online, which is what most teams prefer because it
        removes the commute and fits between meetings, and I can also come to your offices anywhere
        in the metro area. For companies outside Jalisco or outside Mexico, we work online with
        invoicing in pesos or dollars.
      </p>
    </div>
  </section>

  <!-- HR -->
  <section class="bg-white py-12 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto max-w-3xl">
      <div class="border-l-4 border-blue-400 pl-8">
        <p class="text-sm font-semibold text-blue-600 uppercase tracking-wide mb-2">
          For HR Managers
        </p>
        <h2 class="text-xl font-bold mb-3">Evaluating providers for your company?</h2>
        <p class="text-gray-600 mb-4 text-sm">
          There is a separate page for whoever has to justify the investment internally: what HR
          receives, how progress is measured, and what to ask before signing with any corporate
          English provider.
        </p>
        <a
          href="/en/for-hr-managers/"
          class="inline-flex items-center gap-2 text-blue-600 font-semibold text-sm hover:underline"
        >
          See the HR manager page <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <LeadMagnetForm lang="en" sourcePage="/en/corporate-english-training-guadalajara/" />

  <CtaSection content={ctaContent} />
</Base>
