---
export const prerender = true;

import Base from "@layouts/Base.astro";
import InnerHero from "@components/sections/InnerHero.astro";
import Challenge from "@components/sections/Challenge.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import LeadMagnetCallout from "@components/sections/LeadMagnetCallout.astro";
import LeadMagnetForm from "@components/sections/LeadMagnetForm.astro";
import ServiceFAQ from "@components/sections/ServiceFAQ.astro";
import BreadcrumbSchema from "@components/seo/BreadcrumbSchema.astro";
import TestimonialCard from "@components/ui/TestimonialCard.astro";
import { serviceFaqs } from "@data/service-faqs";
import { corporatePackage as serviceData } from "@data/services";
import pressureImage from "@assets/images/services/corporate-meeting-pressure.jpg";
import { testimonials as enTestimonials } from "@data/testimonials/en";

const corporateTestimonial = enTestimonials.find(
  (t) => t.slug === "jose-antonio-lopez-terramar-brands",
);

/**
 * Company names shown in the roster strip.
 *
 * Deliberately FILTERED against the published testimonials rather than
 * hardcoded: every name below only renders if that company still has a live,
 * named testimonial on the site. Pull a testimonial and the logo strip stops
 * claiming that client automatically, which is the failure mode a hardcoded
 * list would ship silently.
 */
const FEATURED_CLIENTS = [
  "Driscoll's",
  "Continental",
  "Sanmina Corporation",
  "CEVA Logistics",
  "Terramar Brands",
  "Grupo Kopar",
  "Smarttie",
  "100 Ladrillos",
];
const publishedCompanies = new Set(enTestimonials.map((t) => t.company).filter(Boolean));
const corporateClients = FEATURED_CLIENTS.filter((c) => publishedCompanies.has(c));

/**
 * Short pull-quotes under the client roster.
 *
 * Each excerpt must be a verbatim substring of the published testimonial: if the testimonial is retired or drafted, the quote drops out on its own; if the excerpt stops matching the published text, the build fails rather than shipping a quote that is no longer verbatim.
 */
const PROOF_QUOTES = [
  {
    slug: "andres-driscolls",
    excerpt:
      "Coaching with Robert helped me become much more confident and natural when speaking English—especially with U.S. clients.",
  },
  {
    slug: "hugo-lopez-continental",
    excerpt:
      "Under his guidance, I moved from feeling hesitant in senior-level discussions to speaking with assurance in top-management meetings and presenting complex updates with clarity and persuasion.",
  },
  {
    slug: "alberto-escobar-terramar-brands",
    excerpt:
      "I lead meetings more confidently, communicate more clearly with international partners, and get better results across the board.",
  },
];
const proofQuotes = PROOF_QUOTES.flatMap(({ slug, excerpt }) => {
  const t = enTestimonials.find((x) => x.slug === slug && x.status !== "draft");
  if (!t) return [];
  if (!t.content.includes(excerpt)) {
    throw new Error(`corporate page: excerpt for "${slug}" is no longer a verbatim substring of the published testimonial`);
  }
  return [{ excerpt, author: t.author, position: t.position, company: t.company }];
});

const title = "12-Week Corporate English for Leadership Teams";
const seoDescription =
  "Your managers already speak English. A 12-week program so they present, answer and defend their ideas in English under real professional pressure.";

const heroContent = {
  title: "Your managers already speak English. The challenge starts when the meeting matters.",
  description:
    "A 12-week program so your leadership team can present, field unexpected questions and defend a recommendation in English — in front of North American clients, colleagues and international leadership — with the same authority they already carry in Spanish.",
  backgroundImage: serviceData.backgroundImage,
  overlayOpacity: 0.75,
  imageAlt: "Leadership team in a business English coaching session",
  cta: { text: "Schedule a discovery call", link: "/en/book/" },
};

const challengeContent = {
  headline: "The problem isn't English knowledge. It's English performance under professional pressure.",
  painPoints: [
    "Your team's English works in email and on the routine call. It changes when a question arrives that nobody anticipated, when a position has to be held, or when the conversation speeds up: the answer simplifies, the idea loses its nuance, and the person sounds less experienced than they actually are.",
    "In front of a client in the United States or Canada the cost is direct. The same manager who projects judgment and authority in Spanish can sound less decisive, less senior and less informed — not for lack of capability, but because the language costs them response speed at the exact moment they need it.",
    "An English course trains the knowledge, not the moment. You can pass any exam and still not be able to defend a recommendation in English with five people waiting on the answer.",
  ],
  icon: "💡",
  image: pressureImage,
  imageAspect: "landscape",
  imageAlt:
    "Boardroom meeting: one manager listens under visible strain while a colleague presents and the team debates",
  quizCta: {
    text: "Take the Executive Communication Assessment — 60 seconds.",
    link: "/en/quiz/executives/question/1/",
    linkLabel: "Start the Quiz →",
    style: "link",
  },
};

const ctaContent = {
  eyebrow: "Corporate Programs",
  title: "Ready to build a management team that leads in English?",
  description:
    "This program requires a discovery call to scope for your group size, schedule, and goals. Robert is a native New Yorker who has coached senior executives and leadership teams across Mexico for over a decade. He responds within 24 hours.",
  buttonSubtext: "Most discovery calls take 30 minutes.",
  buttonText: "Schedule a Discovery Call",
  buttonLink: "/en/book/",
  secondaryButtonText: "Contact Robert on WhatsApp",
  secondaryButtonLink: "https://wa.me/523315590572",
  whatToExpectTitle: "In Your Discovery Call, We Will:",
  whatToExpectList: [
    "Identify the specific situations where your team's English loses authority",
    "Scope the program for your group size, schedule, and industry context",
    "Define what a successful outcome looks like for your team",
  ],
};

const faqs = serviceFaqs["corporate-package"]?.en || [];
---

<Base
  title={title}
  description={seoDescription}
  lang="en"
  tkey="services/corporate-package"
  hideCta={true}
>
  <!-- Hero -->
  <InnerHero content={heroContent} />

  <!-- Client roster — the first thing a referred evaluator looks for -->
  {corporateClients.length > 0 && (
    <section class="bg-white pt-12 pb-12 px-8">
      <div class="site-container--small mx-auto">
        <p class="text-center text-sm text-gray-500 mb-6">
          This program was delivered to the management team at Terramar Brands. Leaders at these
          companies have worked with me one to one.
        </p>
        <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3">
          {corporateClients.map((name) => (
            <li class="text-gray-500 font-bold uppercase tracking-[0.18em] text-sm">{name}</li>
          ))}
        </ul>
        {proofQuotes.length > 0 && (
          <div class="grid gap-4 md:grid-cols-3 mt-10">
            {proofQuotes.map((q) => (
              <figure class="bg-light rounded-xl p-6 border border-gray-100">
                <blockquote class="text-sm text-gray-700 leading-relaxed">“{q.excerpt}”</blockquote>
                <figcaption class="mt-4 text-xs text-gray-500">
                  <span class="font-semibold text-gray-800">{q.author}</span>
                  <br />
                  {q.position}, {q.company}
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Challenge -->
  <Challenge content={challengeContent} background="white" padding="lg" />

  <!-- Lead Magnet Callout (subtle early touchpoint) -->
  <LeadMagnetCallout lang="en" variant="link" />

  <!-- Program Structure -->
  <section class="bg-light py-16 px-8">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-2 text-center">How the Program Works</h2>
      <p class="text-center text-gray-600 mb-12">12 weeks across 3 phases. 1-on-1 sessions with a New York coach, built on the meetings, calls and presentations your team already has on the calendar — and a real performance test at the end.</p>

      <div class="grid gap-8 md:grid-cols-3">
        <!-- Phase 1 -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 flex flex-col">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Weeks 1–8</div>
          <h3 class="text-xl font-bold mb-3">Phase 1 — Individual Assessment & Preparation</h3>
          <p class="text-gray-600 mb-4">Each participant works privately with Robert. Weeks 1–2 establish an honest baseline of how their English changes as the pressure rises. Weeks 3–8 are targeted rehearsal on their real situations: their meetings, their calls with North American clients, the presentation already on their calendar, and the uncomfortable questions any of those can produce.</p>
          <div class="text-sm text-gray-500 mt-auto pt-4 border-t border-gray-100">
            <strong>8–12 sessions per participant</strong><br />
            4,800 – 7,200 MXN
          </div>
        </div>

        <!-- Phase 2 -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 flex flex-col">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Weeks 9–10</div>
          <h3 class="text-xl font-bold mb-3">Phase 2 — Performance in Front of the Leadership Team</h3>
          <p class="text-gray-600 mb-4">Each participant presents in English to the full leadership group and fields questions live — often for the first time. There is no option to switch back to Spanish, the same as in the real meeting. The pressure is deliberate, and it is the point: it is the only way to train the moment a course never touches.</p>
          <div class="text-sm text-gray-500 mt-auto pt-4 border-t border-gray-100">
            <strong>1–2 group sessions</strong><br />
            600 – 1,200 MXN per participant
          </div>
        </div>

        <!-- Phase 3 -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 flex flex-col">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Weeks 11–12</div>
          <h3 class="text-xl font-bold mb-3">Phase 3 — Lessons Learned & Final Assessment</h3>
          <p class="text-gray-600 mb-4">Individual debrief sessions with direct, honest feedback on what held under pressure and what did not. A final assessment measures progress against the Week 1–2 baseline. Each participant receives a written roadmap. The company receives a consolidated progress report.</p>
          <div class="text-sm text-gray-500 mt-auto pt-4 border-t border-gray-100">
            <strong>2–3 sessions per participant</strong><br />
            1,200 – 1,800 MXN
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formal Review Deliverables -->
  <section class="bg-white py-16 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-2 text-center">What the Formal Reviews Include</h2>
      <p class="text-center text-gray-600 mb-12 max-w-xl mx-auto">This is what separates the structured program from flexible ongoing coaching. Three formal deliverables per participant, plus a company-level report.</p>

      <div class="max-w-5xl mx-auto">
      <div class="grid gap-10 lg:grid-cols-5 items-center">
        <figure class="lg:col-span-2">
          <div class="relative mx-auto max-w-sm">
            <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-lg bg-gray-200/70" aria-hidden="true"></div>
            <div class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-lg bg-gray-100 border border-gray-200" aria-hidden="true"></div>
            <div class="relative rounded-lg bg-white border border-gray-200 shadow-lg p-6 sm:p-7" role="img" aria-label="Sample format of the Initial Student Profile">
              <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-4">
                <span class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-primary">New York English</span>
                <span class="text-[0.6rem] uppercase tracking-wider text-gray-400">Confidential</span>
              </div>
              <p class="text-[0.6rem] font-semibold uppercase tracking-wide text-gray-400 mb-2">Initial Student Profile</p>
              <div class="h-3 w-2/3 rounded bg-gray-800/80 mb-1.5" aria-hidden="true"></div>
              <div class="h-2 w-1/2 rounded bg-gray-300 mb-5" aria-hidden="true"></div>
              <div class="mb-4">
                <p class="text-xs font-bold text-gray-800 mb-1.5">1. Current English level and observable patterns</p>
                <div class="space-y-1.5" aria-hidden="true"><div class="h-2 rounded bg-gray-200 w-full"></div><div class="h-2 rounded bg-gray-200 w-11/12"></div><div class="h-2 rounded bg-gray-200 w-3/4"></div></div>
              </div>
              <div class="mb-4">
                <p class="text-xs font-bold text-gray-800 mb-1.5">2. Job role, responsibilities and team context</p>
                <div class="space-y-1.5" aria-hidden="true"><div class="h-2 rounded bg-gray-200 w-full"></div><div class="h-2 rounded bg-gray-200 w-5/6"></div></div>
              </div>
              <div class="mb-4">
                <p class="text-xs font-bold text-gray-800 mb-1.5">3. Job-related goals and high-stakes moments</p>
                <div class="space-y-1.5" aria-hidden="true"><div class="h-2 rounded bg-gray-200 w-full"></div><div class="h-2 rounded bg-gray-200 w-11/12"></div><div class="h-2 rounded bg-gray-200 w-3/4"></div></div>
              </div>
              <div class="mb-4">
                <p class="text-xs font-bold text-gray-800 mb-1.5">4. Priority focus areas — Phases 1–3</p>
                <div class="space-y-1.5" aria-hidden="true"><div class="h-2 rounded bg-gray-200 w-full"></div><div class="h-2 rounded bg-gray-200 w-5/6"></div></div>
              </div>
              <div class="mt-5 pt-3 border-t border-gray-100 flex items-center justify-between gap-4 text-[0.6rem] text-gray-400">
                <span>Baseline — session 1–2</span><span class="text-right">Re-measured in week 12</span>
              </div>
            </div>
          </div>
          <figcaption class="mt-5 text-center text-xs text-gray-500 max-w-sm mx-auto">Sample format. Each participant receives their own in writing after session 1–2, and the Phase 3 final assessment is measured against it.</figcaption>
        </figure>
        <div class="lg:col-span-3 bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Delivered after Session 1–2</div>
          <h3 class="text-xl font-bold mb-3">Initial Student Profile</h3>
          <p class="text-gray-600 text-sm mb-4">A written baseline document for each participant, produced after the first session. Covers:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Current English level and observable communication patterns</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Job role, responsibilities, and team context</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Job-related English goals and high-stakes communication moments</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Priority focus areas for Phases 1–3</li>
          </ul>
          <p class="text-xs text-gray-400 mt-4">This document is the program baseline. Phase 3 measures progress against it.</p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3 mt-6">
        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Delivered monthly throughout the program</div>
          <h3 class="text-xl font-bold mb-3">Monthly Assessments</h3>
          <p class="text-gray-600 text-sm mb-4">One assessment per participant per month. Each covers five areas:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Ongoing gaps</strong> — the specific communication patterns still showing up that matter most</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Level of effort</strong> — preparation quality and practice outside of sessions, assessed honestly</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Enthusiasm and engagement</strong> during sessions</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>In-session performance</strong> — fluency, clarity, confidence under pressure</span></li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> <span><strong>Updated priority areas</strong> based on recent work</span></li>
          </ul>
          <p class="text-xs text-gray-400 mt-4">Sessions are never AI-recorded. All assessment content comes from Robert's direct observation.</p>
        </div>

        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Delivered at program close — per participant</div>
          <h3 class="text-xl font-bold mb-3">Written Individual Roadmap</h3>
          <p class="text-gray-600 text-sm mb-4">A personalized written document for each participant covering:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Progress measured against the initial baseline</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Remaining priority gaps and how to address them</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Recommended focus areas and practice approaches for continued development</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Honest summary of where they stand after the program</li>
          </ul>
        </div>

        <div class="bg-light rounded-xl p-8 border border-gray-100">
          <div class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Delivered at program close — for the company</div>
          <h3 class="text-xl font-bold mb-3">Consolidated Company Report</h3>
          <p class="text-gray-600 text-sm mb-4">A summary-level document for HR and executive review covering:</p>
          <ul class="text-sm text-gray-600 space-y-2">
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Team-level progress and collective patterns observed</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Notable achievements and breakthroughs across the group</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Recommendations for continued team development</li>
            <li class="flex gap-2"><span class="text-primary font-bold shrink-0">→</span> Overview of program outcomes against original goals</li>
          </ul>
          <p class="text-xs text-gray-400 mt-4">Individual performance details are kept in the personal roadmap documents, not the company report.</p>
        </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Investment -->
  <section class="bg-white py-16 px-4 sm:px-8">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-2 text-center">Investment</h2>
      <p class="text-center text-gray-600 mb-10">600 MXN per session per participant. Mexican facturas issued monthly.</p>

      <div class="max-w-2xl mx-auto bg-gray-50 rounded-xl p-4 sm:p-8 border border-gray-200">
        <div class="overflow-x-auto">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left pb-3 font-semibold">Scenario</th>
              <th class="text-right pb-3 font-semibold">Per participant (MXN)</th>
              <th class="text-right pb-3 font-semibold">Team of 5 (MXN)</th>
            </tr>
          </thead>
          <tbody class="text-gray-600">
            <tr class="border-b border-gray-100">
              <td class="py-3">Conservative (12 sessions)</td>
              <td class="text-right py-3 whitespace-nowrap">7,200</td>
              <td class="text-right py-3 whitespace-nowrap">≈ 36,000</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-3">Moderate (14–15 sessions)</td>
              <td class="text-right py-3 whitespace-nowrap">8,400–9,000</td>
              <td class="text-right py-3 whitespace-nowrap">≈ 42,000–45,000</td>
            </tr>
            <tr>
              <td class="py-3">Intensive (17 sessions)</td>
              <td class="text-right py-3 whitespace-nowrap">10,200</td>
              <td class="text-right py-3 whitespace-nowrap">≈ 51,000</td>
            </tr>
          </tbody>
        </table>
        </div>
        <p class="text-xs text-gray-400 mt-4">Total varies because schedules vary — not every participant attends every possible session. USD pricing available for international companies.</p>
      </div>

      <div class="max-w-2xl mx-auto mt-6 bg-gray-50 border border-gray-200 rounded-xl p-6 text-sm text-gray-600">
        <strong class="text-gray-900">What the corporate rate covers that individual coaching does not.</strong>
        My private 1-on-1 coaching is 500 MXN per session and that is exactly what it is: the
        session. The 600 MXN corporate rate adds the group presentation session in front of the
        leadership team, the initial assessment and the final one measured against that baseline,
        written monthly assessments, each participant's individual roadmap, and the consolidated
        report for HR and executive review. If what your team needs is sessions without that
        measurement and reporting layer, individual coaching is the right call and it costs less.
      </div>

      <div class="max-w-2xl mx-auto mt-6 bg-amber-50 border border-amber-200 rounded-xl p-6 text-sm text-amber-900">
        <strong>Results depend on individual commitment.</strong> The program is designed to create breakthroughs — but breakthroughs require preparation between sessions, honest engagement with feedback, and the willingness to perform under pressure. Participants who prepare seriously typically see significant performance gains. Those who attend but don't prepare will see limited results.
      </div>
    </div>
  </section>

  <!-- Client Testimonial -->
  {corporateTestimonial && (
    <section class="bg-white py-16 px-8 border-t border-gray-100">
      <div class="site-container--small mx-auto max-w-2xl">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2 text-center">From a Recent Client</p>
        <h2 class="text-3xl font-bold mb-10 text-center">What HR Leadership Says</h2>
        <TestimonialCard testimonial={corporateTestimonial} showHeadline={true} showReadMore={false} />
      </div>
    </section>
  )}

  <!-- How companies evaluate this — the referred buyer's real questions -->
  <section class="bg-white py-16 px-8 border-t border-gray-100">
    <div class="site-container--small mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold mb-2 text-center">How companies evaluate this</h2>
      <p class="text-center text-gray-600 mb-10">
        Most of the companies I work with were referred by someone already in a session. This is what
        the evaluation usually looks like from your side.
      </p>

      <div class="space-y-6">
        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold text-lg mb-2">1. A demo class, and you sit in on it</h3>
          <p class="text-gray-600 text-sm">
            Before any commitment, one of your people takes a real session and you watch it. Not a
            sales call and not a sample lesson built for the demo — an actual session on that
            person's actual work. You will see the coaching, the correction style, and how your
            colleague responds to it, and you can decide from there.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold text-lg mb-2">2. Invoicing your finance team can process</h3>
          <p class="text-gray-600 text-sm">
            I invoice under a Mexican RFC and issue facturas monthly against the sessions actually
            delivered. USD invoicing is available for companies billing outside Mexico. If your
            procurement team needs the tax details before a vendor can be opened, ask and I will
            send them.
          </p>
        </div>

        <div class="border-l-4 border-primary pl-6">
          <h3 class="font-bold text-lg mb-2">3. The price does not change with headcount</h3>
          <p class="text-gray-600 text-sm">
            There is no volume discount, and I would rather say so early than discover it matters at
            the end. Every session is built for one person's role and their next real pressure
            moment, so five participants is five separate preparations rather than one lesson
            delivered five times. The rate reflects that.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="bg-light py-16 px-8">
    <div class="site-container--small mx-auto">
      <h2 class="text-3xl font-bold mb-10 text-center">What This Program Produces</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="font-bold text-lg mb-4">For Each Participant</h3>
          <p class="text-sm text-gray-500 mb-4">The goal is not "more confidence" in the abstract. It is observable performance: by the end of the program, each participant can do these things in English.</p>
          <ul class="space-y-3 text-gray-600">
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Present an idea with structure and get to the point, without padding</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Field a question they did not anticipate without losing the thread or dropping the register</li>
            <li class="flex gap-3"><span class="text-green-500 font-bold mt-0.5">✓</span> Explain and defend a recommendation to someone who disagrees</li>
