---
export const prerender = true;

import Base from "@layouts/Base.astro";
import FaqsSegmented from "@components/sections/FaqsSegmented.astro";
import FAQSchema from "@components/seo/FAQSchema.astro";
import Button from "@components/ui/Button.astro";
import { segmentedFaqLists } from "@data/faqs";
import faqHeroImage from "@assets/images/faq/faq-hero.jpg";

const seoTitle = "English Coaching Questions Answered | NY English Teacher";
const seoDescription =
  "Everything you need to know about closing your Communication Gap and scaling your career with premium English coaching for professionals.";

const faqData = segmentedFaqLists.premium;
const allFaqs = faqData.sections.flatMap((section) => section.faqs);
---

<Base
  title={seoTitle}
  description={seoDescription}
  lang="en"
  tkey="faqs"
>
  <FAQSchema faqs={allFaqs} />

  <!-- Premium Hero Section -->
  <section class="faq-hero">
    <img
      src={faqHeroImage.src}
      alt="FAQ Hero Background"
      class="hero-bg-image"
    />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Frequently asked questions</p>
      <h1 class="hero-title">Your Questions, My Answers</h1>
      <p class="hero-subtitle">
        Real, honest answers to what you're actually wondering about — from
        me personally, not a script.
      </p>
    </div>
  </section>

  <!-- Segmented FAQ Sections -->
  <FaqsSegmented
    sections={faqData.sections}
    showCta={true}
    ctaHeading="Ready to turn fluency into influence?"
    ctaButtonText="Book Your Free Discovery Call"
    ctaButtonLink="/en/book/"
  />

  <!-- Still have a question -->
  <section class="bg-white py-16 border-t border-slate-200">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-3">
        Didn't find your question?
      </h2>
      <p class="text-lg text-slate-600 mb-8">
        Message me directly and I'll answer you personally.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button
          href="https://wa.me/523315590572"
          target="_blank"
          rel="noopener noreferrer"
          variant="whatsapp"
          size="lg"
        >
          Message Me on WhatsApp
        </Button>
        <a
          href="mailto:robert@nyenglishteacher.com"
          class="font-semibold text-blue-700 hover:text-blue-800"
        >
          Or send me an email
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .faq-hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 50, 0.75) 0%,
      rgba(30, 64, 175, 0.65) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 100px 5% 100px 5%;
    color: white;
    text-align: left;
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fbbf24;
    margin-bottom: 1rem;
    font-family: "Courier New", monospace;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: white;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .hero-subtitle {
    font-size: 1.375rem;
    line-height: 1.6;
    color: #e2e8f0;
    max-width: 700px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 768px) {
    .faq-hero {
      min-height: 400px;
    }

    .hero-content {
      padding: 60px 20px 60px 20px;
    }

    .hero-eyebrow {
      font-size: 0.75rem;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }
  }
</style>
