---
import { siteConfig } from "@data/config.ts";

// Get site URL from config for structured data
const siteUrl = siteConfig.siteUrl || 'https://www.nyenglishteacher.com';
const cleanSiteUrl = siteUrl.replace(/https?:\/\/www\.www\./i, 'https://www.').replace(/\/$/, '');

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${cleanSiteUrl}/#website`,
  "name": siteConfig.companyName,
  // Machine-readable proof that the longer forms used in the Terms of Service,
  // Privacy Policy and blog prose name the SAME entity as the brand. Meta's
  // WhatsApp display-name review tests the submitted name for an exact match
  // against the business website; the site served five different strings and the
  // name was declined 2026-09-06. Keep in sync with the legal documents.
  "alternateName": ["New York English Teacher", "New York English"],
  "url": cleanSiteUrl + "/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": cleanSiteUrl + "/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(website)}></script>
