---
/**
 * QuizTestimonials — real client quotes for the quiz hub pages (/en/quiz/,
 * /es/quiz/). Picks and the verbatim-excerpt check live in
 * src/data/quiz/real-testimonials.ts, shared with the four quiz landings.
 */
import { getQuizTestimonials } from "../../data/quiz/real-testimonials";

export interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const cards = getQuizTestimonials(lang, "hub").map((t) => ({
  excerpt: t.quote,
  author: t.name,
  role: t.location ? `${t.title}, ${t.location}` : t.title,
}));
---

<div class="testimonial-cards">
  {
    cards.map((c) => (
      <div class="testimonial-card">
        <p class="testimonial-text">"{c.excerpt}"</p>
        <cite>
          — {c.author}, {c.role}
        </cite>
      </div>
    ))
  }
</div>

<style>
  .testimonial-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .testimonial-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  .testimonial-card {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .testimonial-card {
      padding: 2rem;
    }
  }

  .testimonial-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #2d3748;
    margin-bottom: 0.875rem;
    font-style: italic;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .testimonial-text {
      font-size: 1rem;
      margin-bottom: 1rem;
    }
  }

  .testimonial-card cite {
    font-size: 0.8125rem;
    color: #718096;
    font-style: normal;
    display: block;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .testimonial-card cite {
      font-size: 0.875rem;
    }
  }

</style>
