---
/** Course overview page for a data-driven master class (EN + ES). */
import { ArrowLeft, ArrowRight, CheckCircle2, Clock, Mic, Scale, PenLine } from "lucide-astro";
import {
  fill,
  lessonRoute,
  masterclassUi,
  pick,
  type Course,
  type MasterclassLang,
} from "@data/masterclass/index";

interface Props {
  lang: MasterclassLang;
  course: Course;
}
const { lang, course } = Astro.props;
const ui = masterclassUi[lang];
const icons = { Mic, Scale, PenLine };
const Icon = icons[course.icon];
const p = (pair: [string, string]) => pick(pair, lang);
const first = lessonRoute(course, course.lessons[0], lang);
const totalMinutes = course.lessons.reduce((n, l) => n + l.minutes, 0);
const coursesHref = lang === "es" ? "/es/cursos/" : "/en/courses/";
---

<div data-mc-hub={course.id}>
  <section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="site-container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
          <Icon class="w-4 h-4" />
          {p(course.level)}
        </div>
        <h1
          class="text-3xl md:text-5xl font-bold text-white mb-3 leading-tight"
          style="font-family: 'Noto Sans KR', sans-serif;"
        >
          {p(course.name)}
        </h1>
        <p class="text-xl md:text-2xl font-semibold mb-5" style="color:#c7d2fe">
          {p(course.tagline)}
        </p>
        <p class="text-lg max-w-2xl leading-relaxed mb-8" style="color:#cbd5e1">{p(course.sub)}</p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={first}
            data-mc-cta
            data-l-resume={ui.resume}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold transition-colors"
          >
            <span data-mc-cta-text>{ui.start}</span>
            <ArrowRight class="w-5 h-5" />
          </a>
          <span class="inline-flex items-center gap-2 text-sm" style="color:#a5b4fc">
            <Clock class="w-4 h-4" />
            {
              `${fill(ui.lessonsCount, { n: course.lessons.length })} · ${fill(ui.minutes, { n: totalMinutes })}`
            }
          </span>
        </div>
        <p
          class="text-sm mt-4"
          style="color:#a5b4fc"
          data-mc-status
          data-tpl={ui.progress}
          hidden
          aria-live="polite"
        >
        </p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-white">
    <div class="site-container mx-auto px-4">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-2xl font-bold mb-5" style="color:#0f172a">{ui.outcomesTitle}</h2>
          <ul class="space-y-3">
            {
              course.outcomes.map((o) => (
                <li class="flex items-start gap-3">
                  <CheckCircle2 class="w-5 h-5 text-indigo-500 shrink-0 mt-0.5" />
                  <span class="leading-relaxed" style="color:#334155">
                    {p(o)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-7">
          <h2 class="text-xl font-bold mb-3" style="color:#0f172a">{ui.methodTitle}</h2>
          <p class="leading-relaxed" style="color:#334155">{p(course.method)}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-slate-50 border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-8" style="color:#0f172a">{ui.lessonsTitle}</h2>
        <ol class="space-y-3 list-none p-0 m-0">
          {
            course.lessons.map((l, i) => (
              <li>
                <a
                  href={lessonRoute(course, l, lang)}
                  data-mc-lesson={l.id}
                  class="mc-row group flex items-start gap-4 bg-white rounded-2xl border border-slate-200 p-5 hover:border-indigo-400 hover:shadow-md transition-all"
                >
                  <span class="mc-row-n flex items-center justify-center w-10 h-10 rounded-xl bg-indigo-500 text-white font-bold shrink-0">
                    {i + 1}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-lg font-bold leading-snug" style="color:#0f172a">
                      {p(l.title)}
                    </span>
                    <span class="block text-sm leading-relaxed mt-1" style="color:#475569">
                      {p(l.summary)}
                    </span>
                    <span
                      class="flex items-center gap-3 text-xs font-semibold mt-2"
                      style="color:#64748b"
                    >
                      <span>{fill(ui.minutes, { n: l.minutes })}</span>
                      <span class="mc-row-done" style="color:#047857">
                        {ui.done}
                      </span>
                    </span>
                  </span>
                  <ArrowRight class="w-5 h-5 text-indigo-500 shrink-0 mt-2 transition-transform group-hover:translate-x-0.5" />
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white border-t border-slate-200">
    <div class="site-container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl bg-slate-900 p-8 md:p-10">
          <h2 class="text-2xl font-bold text-white mb-3">{ui.coachTitle}</h2>
          <p class="leading-relaxed mb-6" style="color:#cbd5e1">{ui.coachText}</p>
          <a
            href={ui.coachHref}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold transition-colors"
          >
            {ui.coachCta}
            <ArrowRight class="w-5 h-5" />
          </a>
        </div>
        <p class="mt-10 text-center">
          <a
            href={coursesHref}
            class="inline-flex items-center gap-2 text-sm text-indigo-700 hover:text-indigo-800 underline underline-offset-2"
          >
            <ArrowLeft class="w-4 h-4" />
            {ui.allCourses}
          </a>
        </p>
      </div>
    </div>
  </section>
</div>

<style>
  .mc-row-done {
    display: none;
  }
  .mc-row.is-done .mc-row-done {
    display: inline;
  }
  .mc-row.is-done .mc-row-n {
    background: #047857;
  }
</style>

<script>
  import "./masterclass.client";
</script>
