---
/**
 * Conversation Briefings — one topic page (EN + ES).
 *
 * Every term and definition is rendered to static HTML at build time, so the whole bank
 * is crawlable and reads as a plain glossary without JavaScript. topic.client.ts adds
 * reveal/hide, search, filters and the ten-question check, which it builds from this markup.
 */
import "../collocations/collocations.css";
import "./conversation.css";
import { ArrowLeft, ArrowRight, Landmark, Church, BookOpen, Home, Handshake, Scale, Mic, HeartHandshake } from "lucide-astro";
import {
  conversationRoutes,
  conversationUi,
  fill,
  getTopicCheat,
  getTopicGroups,
  pick,
  tagOrder,
  topicRoute,
  topics,
  type ConversationLang,
  type Topic,
} from "@data/conversation/index";

interface Props {
  lang: ConversationLang;
  topic: Topic;
}
const { lang, topic } = Astro.props;

const ui = conversationUi[lang];
const groups = getTopicGroups(topic, lang);
const cheat = getTopicCheat(topic, lang);
const total = groups.reduce((n, g) => n + g.items.length, 0);
const routes = conversationRoutes[lang];
const icons = { Landmark, Church, BookOpen, Home, Handshake, Scale, Mic, HeartHandshake };
const Icon = icons[topic.icon];

const present = new Set(groups.flatMap((g) => g.items.flatMap((it) => it.tags)));
const chips: [string, string][] = [
  ["all", ui.chips.all],
  ...tagOrder.filter((t) => present.has(t)).map((t): [string, string] => [t, ui.chips[t]]),
];

const stripTags = (s: string) => s.replace(/<[^>]+>/g, " ");
const searchText = (...parts: (string | undefined)[]) =>
  stripTags(parts.filter(Boolean).join(" "))
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9 ]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const others = topics.filter((t) => t.id !== topic.id);
const clientStrings = {
  total,
  countAll: ui.countAll,
  countSome: ui.countSome,
  quiz: ui.quiz,
};
---

<!-- Hero -->
<section class="bg-gradient-to-b from-slate-900 to-indigo-950 pt-28 pb-16 md:pt-36 md:pb-20">
  <div class="site-container mx-auto px-4 text-white">
    <div class="max-w-3xl">
      <a
        href={routes.hub}
        class="inline-flex items-center gap-2 text-sm text-indigo-300 hover:text-white mb-4"
      >
        <ArrowLeft class="w-4 h-4" />
        {ui.backHub}
      </a>
      <div class="flex items-center gap-2 text-indigo-300 text-sm font-semibold mb-3">
        <Icon class="w-4 h-4" />
        {pick(topic.eyebrow, lang)}
      </div>
      <h1
        class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight"
        style="font-family: 'Noto Sans KR', sans-serif;"
      >
        {pick(topic.h1, lang)}
      </h1>
      <p
        class="text-lg text-slate-300 max-w-2xl leading-relaxed"
        set:html={pick(topic.sub, lang)}
      />
    </div>
  </div>
</section>

<section class="py-12 md:py-16 bg-slate-50">
  <div class="site-container mx-auto px-4">
    <div class="colx max-w-4xl mx-auto" id="conv-ref" data-strings={JSON.stringify(clientStrings)}>
      <div class="howto">
        <p set:html={pick(topic.frame, lang)} />
      </div>

      <p class="idxlabel">{ui.jump}</p>
      <nav class="index" id="conv-index" aria-label={ui.jump}>
        {
          groups.map((g, gi) => (
            <a href={`#g${gi}`}>
              <span class="n">{gi + 1}</span>
              <span class="t">{g.title}</span>
              <span class="c">{g.items.length}</span>
            </a>
          ))
        }
      </nav>

      <div class="toolbar">
        <div class="row">
          <span class="count" id="conv-count" aria-live="polite"
            >{fill(ui.countAll, { total })}</span
          >
          <button
            type="button"
            class="btn"
            id="conv-accordion"
            aria-pressed="true"
            title={ui.accordionTitle}>{ui.accordion}</button
          >
          <button type="button" class="btn" id="conv-reveal">{ui.revealAll}</button>
          <button type="button" class="btn" id="conv-hide">{ui.hideAll}</button>
        </div>
        <input
          type="search"
          id="conv-search"
          placeholder={fill(ui.searchPlaceholder, { examples: topic.searchExamples })}
          aria-label={ui.searchLabel}
        />
        <div class="chips" id="conv-chips" role="group" aria-label={ui.filterLabel}>
          {
            chips.map(([tag, label], i) => (
              <button
                type="button"
                class="chip"
                data-tag={tag}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                {label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="cheat">
        <h2>{pick(topic.cheatTitle, lang)}</h2>
        <p class="lead">{ui.cheatLead}</p>
        <div class="grid">
          {
            cheat.map(([label, text]) => (
              <div class="cell">
                <b>{label}</b>
                <span set:html={text} />
              </div>
            ))
          }
        </div>
      </div>

      <div id="conv-sections">
        {
          groups.map((g, gi) => (
            <section class="group" id={`g${gi}`}>
              <div class="sec-head">
                <span class="sec-num">
                  {ui.group} {gi + 1}
                </span>
                <h2 class="sec-title">{g.title}</h2>
              </div>
              <p class="rule" set:html={g.rule} />
              <div class="list">
                {g.items.map((it, ii) => (
                  <div
                    class="item plain"
                    id={`i${it.id}`}
                    data-id={it.id}
                    data-group={gi}
                    data-tags={it.tags.join(" ")}
                    data-text={searchText(it.q, it.hint, it.a, it.ex, it.note, it.trap)}
                  >
                    <button
                      type="button"
                      class="head"
                      aria-expanded="false"
                      aria-controls={`b${it.id}`}
                    >
                      <span class="q">
                        {ii + 1}.{" "}
                        <span class="term" lang="en">
                          {it.q}
                        </span>
                        {it.hint && <span class="hint">{it.hint}</span>}
                        {it.trap && <span class="badge b-trap">{ui.badgeTrap}</span>}
                        {it.tags.includes("falsefriend") && (
                          <span class="badge b-ff">{ui.badgeFf}</span>
                        )}
                      </span>
                      <span class="tap">{ui.tap}</span>
                      <span class="chev" aria-hidden="true" />
                    </button>
                    <div class="body" id={`b${it.id}`}>
                      <p class="ans" set:html={it.a} />
                      <p class="ex" lang="en" set:html={it.ex} />
                      {it.note && <p class="note" set:html={it.note} />}
                      {it.trap && <p class="trap" set:html={it.trap} />}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      <p class="empty" id="conv-empty" hidden>{ui.empty}</p>

      <!-- Ten-question check, built in the browser from the list above -->
      <section class="quiz" id="conv-quiz" aria-labelledby="conv-quiz-title">
        <div class="sec-head">
          <h2 class="sec-title" id="conv-quiz-title">{ui.quiz.title}</h2>
        </div>
        <div class="card" id="conv-quiz-card">
          <p class="intro" style="margin-bottom:16px">{ui.quiz.lead}</p>
          <div class="btnrow">
            <button type="button" class="btn primary" id="conv-quiz-start">{ui.quiz.start}</button>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<!-- Coaching + more briefings -->
<section class="py-14 bg-white border-t border-slate-200">
  <div class="site-container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="rounded-2xl bg-slate-900 p-8 md:p-10 mb-12">
        <h2 class="text-2xl font-bold text-white mb-3">{ui.coach.title}</h2>
        <p class="leading-relaxed mb-6 max-w-2xl" style="color:#cbd5e1">{ui.coach.text}</p>
        <a
          href={ui.coach.href}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold transition-colors"
        >
          {ui.coach.cta}
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>

      <h2 class="text-xl font-bold text-slate-900 mb-4">{ui.more}</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {
          others.map((t) => {
            const OtherIcon = icons[t.icon];
            return (
              <a
                href={topicRoute(t, lang)}
                class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 hover:border-indigo-400 hover:shadow-md transition-all"
              >
                <span class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-500 text-white shrink-0">
                  <OtherIcon class="w-5 h-5" />
                </span>
                <span class="font-semibold text-slate-900">{pick(t.h1, lang)}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import "./topic.client";
</script>
