---
/**
 * JSON-LD for the Conversation Briefings series: BreadcrumbList on every page,
 * a Course on the hub and a LearningResource on each topic page.
 */
import { routeFor } from "../../../lib/i18n";
import {
  conversationRoutes,
  conversationUi,
  pick,
  topicRoute,
  topics,
  type ConversationLang,
  type Topic,
} from "@data/conversation/index";

interface Props {
  lang: ConversationLang;
  topic?: Topic;
}
const { lang, topic } = Astro.props;
const ui = conversationUi[lang];

const SITE = (Astro.site?.href ?? "https://www.nyenglishteacher.com/").replace(/\/+$/, "");
const abs = (path: string) => SITE + path;
const hubUrl = abs(conversationRoutes[lang].hub);
const inLanguage = lang === "es" ? "es-MX" : "en";
const provider = {
  "@type": "Organization",
  name: "New York English Teacher",
  url: SITE + "/",
};

const crumbs = [
  { name: lang === "es" ? "Inicio" : "Home", item: abs(lang === "es" ? "/es/" : "/en/") },
  { name: lang === "es" ? "Cursos" : "Courses", item: abs(routeFor[lang]["courses"]) },
  { name: ui.series, item: hubUrl },
  ...(topic ? [{ name: pick(topic.h1, lang), item: abs(topicRoute(topic, lang)) }] : []),
];
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, ...c })),
};

const main = topic
  ? {
      "@context": "https://schema.org",
      "@type": "LearningResource",
      name: pick(topic.h1, lang),
      url: abs(topicRoute(topic, lang)),
      inLanguage,
      learningResourceType: "Vocabulary reference",
      educationalLevel: "Upper-intermediate to Advanced (B2–C1)",
      isAccessibleForFree: true,
      provider,
      isPartOf: { "@id": `${hubUrl}#course` },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Course",
      "@id": `${hubUrl}#course`,
      name: ui.hub.h1,
      description: ui.hub.description,
      url: hubUrl,
      inLanguage,
      isAccessibleForFree: true,
      provider,
      offers: {
        "@type": "Offer",
        category: "Free",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: "online",
        courseWorkload: "PT4H",
      },
      hasPart: topics.map((t) => ({
        "@type": "LearningResource",
        name: pick(t.h1, lang),
        url: abs(topicRoute(t, lang)),
      })),
    };
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(main)} />
